// @strict-types

#Область ОбработчикиСобытий

// Добавить задание POST.
// 
// Параметры:
//  Запрос - HTTPСервисЗапрос - Запрос
// 
// Возвращаемое значение:
//  HTTPСервисОтвет - Добавить задание POST
//
Функция ДобавитьЗаданиеPOST(Запрос)
	
	Ответ = Неопределено;
	
	ИмяОбработчика = ПараметрURLПоИмени("handler", Запрос);
	
	Если Не ЗначениеЗаполнено(ИмяОбработчика) Тогда
		Ответ = ШаблонHTTPОтветаПлохойЗапрос();
		СведенияОбОшибке = СведенияРезультата();
		СведенияОбОшибке.ОписаниеОшибки = "Адрес запроса не содержит параметр <handler>";
		ТелоОтвета = РаботаСJSON.СериализоватьJSON(СведенияОбОшибке);
		Ответ.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8);
	Иначе
		
		ОбработчикЗадания = 
			РаботаСЗаданиямиCOMСоединений.ОбработчикЗаданияПоИмениОбработчика(ИмяОбработчика);
			
		Если Не ЗначениеЗаполнено(ОбработчикЗадания) Тогда
			
			Ответ = ШаблонHTTPОтветаПлохойЗапрос();
			СведенияОбОшибке = СведенияРезультата();
			ШаблонОписанияОшибки = 
				"Обработчик задания не найден по имени обработчика.
				|ИмяОбработчика: %1";
			СведенияОбОшибке.ОписаниеОшибки = СтрШаблон(ШаблонОписанияОшибки, ИмяОбработчика);
			ТелоОтвета = РаботаСJSON.СериализоватьJSON(СведенияОбОшибке);
			Ответ.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8);
		
		Иначе
			
			ТелоЗапросаСтрокой = Запрос.ПолучитьТелоКакСтроку();
			// Ожидаем получить Массив Из Структура: см. РегистрыСведений.ЗаданияCOMСоединений.ПараметрыЗадания
			ПараметрыЗаданий = РаботаСJSON.ДесериализоватьJSONВСтруктуру(ТелоЗапросаСтрокой);
			
			РезультатДобавления = 
				РаботаСЗаданиямиCOMСоединений.ДобавитьЗадания(
					ОбработчикЗадания,
					ПараметрыЗаданий);
			
			Если Не РезультатДобавления.Успех Тогда
				
				Ответ = ШаблонHTTPОтветаОшибкаСервера();
				СведенияОбОшибке = СведенияРезультата();
				СведенияОбОшибке.ОписаниеОшибки = "Не удалось добавить задание";
				ТелоОтвета = РаботаСJSON.СериализоватьJSON(СведенияОбОшибке);
				Ответ.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8);
				
			Иначе
				
				Ответ = ШаблонHTTPОтветаУспешно();
				СведенияРезультата = СведенияРезультата();
				СведенияРезультата.Успех = Истина;
				СведенияРезультата.Результат = РезультатДобавления.ИдентификаторыЗаданий;
				ТелоОтвета = РаботаСJSON.СериализоватьJSON(СведенияРезультата);
				Ответ.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8);
				
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметр URL по имени.
// 
// Параметры:
//  ИмяПараметра - Строка - Имя параметра
//  Запрос - HTTPСервисЗапрос - Запрос
// 
// Возвращаемое значение:
//  Строка, Неопределено - Параметр URL по имени
//
Функция ПараметрURLПоИмени(ИмяПараметра, Запрос)
	
	Значение = Запрос.ПараметрыURL.Получить(ИмяПараметра);
	Возврат Значение;
	
КонецФункции


// Шаблон HTTP ответа успешно.
// 
// Возвращаемое значение:
//  HTTPСервисОтвет - Шаблон HTTP ответа успешно
//
Функция ШаблонHTTPОтветаУспешно()
	
	Возврат Новый HTTPСервисОтвет(200); 
	
КонецФункции

// Шаблон HTTP ответа плохой запрос.
// 
// Возвращаемое значение:
//   HTTPСервисОтвет - Шаблон HTTP ответа плохой запрос
//  
Функция ШаблонHTTPОтветаПлохойЗапрос()
	
	Возврат Новый HTTPСервисОтвет(400); 
	
КонецФункции

// Шаблон HTTPОтвета ошибка сервера.
// 
// Возвращаемое значение:
//  HTTPСервисОтвет - Шаблон HTTP ответа ошибка сервера
//
Функция ШаблонHTTPОтветаОшибкаСервера()
	
	Возврат Новый HTTPСервисОтвет(500); 
	
КонецФункции

// Сведения результата.
// 
// Возвращаемое значение:
//  Структура - сведения результата:
//   * Успех - Булево
//   * ОписаниеОшибки - Строка
//   * Результат - Неопределено
//
Функция СведенияРезультата()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("Результат", Неопределено);
	Возврат Результат;
	
КонецФункции

#КонецОбласти
