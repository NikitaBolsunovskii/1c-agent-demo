// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗначенияНастроекМенеджераЗаданий = РегистрыСведений.НастройкиМенеджераЗаданий.ЗначенияНастроек();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЗначенияНастроекМенеджераЗаданий);
	
	ЗначенияНастроекМенеджераЗаданийCOMСоединений = РегистрыСведений.НастройкиМенеджераЗаданийCOMСоединений.ЗначенияНастроек();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЗначенияНастроекМенеджераЗаданийCOMСоединений);
	
	ЗначенияНастроекИнтеграцииСERP = РегистрыСведений.НастройкиИнтеграцииСERP.ЗначенияНастроек();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЗначенияНастроекИнтеграцииСERP);
	
	ОбновитьСостояниеМенеджераЗаданий(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ОбработчикОжиданияОбновленияСостояния", 60);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОграничениеНаКоличествоИсполнителейПриИзменении(Элемент)
	ОграничениеНаКоличествоИсполнителейИзменено = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ГлубинаХраненияИсторииПриИзменении(Элемент)
	ГлубинаХраненияИсторииИзменена = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДлительностьАктивныхФоновыхЗаданийПриИзменении(Элемент)
	ДлительностьАктивныхФоновыхЗаданийИзменена = Истина;
КонецПроцедуры

&НаКлиенте
Процедура МаксимальноеКоличествоФоновыхCOMСоединенийПриИзменении(Элемент)
	МаксимальноеКоличествоФоновыхCOMСоединенийИзменено = Истина;
КонецПроцедуры

&НаКлиенте
Процедура АдресСервисаСинхронизацииЕРППриИзменении(Элемент)
	АдресСервисаСинхронизацииЕРПИзменен = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапуститьВыполнениеЗаданий(Команда)
	ЗапуститьВыполнениеЗаданийНаСервере();
	ОбновитьСостояниеМенеджераЗаданий(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьВыполнениеЗаданий(Команда)
	ОстановитьВыполнениеЗаданийНаСервере();
	ОбновитьСостояниеМенеджераЗаданий(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВсеЗаданияВОчереди(Команда)
	ОтменитьВсеЗаданияВОчередиНаСервере();
	ОбновитьСостояниеМенеджераЗаданий(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояниеМенеджера(Команда)
	ОбновитьСостояниеМенеджераЗаданий(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьОграничениеНаКоличествоИсполнителей(Команда)
	СохранитьОграничениеНаКоличествоИсполнителейНаСервере(ОграничениеНаКоличествоИсполнителей);
	ОграничениеНаКоличествоИсполнителейИзменено = Ложь;
	СнятьМодифицированностьПриНеобходимости();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьГлубинуХраненияИстории(Команда)
	СохранитьГлубинуХраненияИсторииНаСервере(ГлубинаХраненияИстории);
	ГлубинаХраненияИсторииИзменена = Ложь;
	СнятьМодифицированностьПриНеобходимости();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДлительностьАктивныхФоновыхЗаданий(Команда)
	СохранитьДлительностьАктивныхФоновыхЗаданийНаСервере(ДлительностьАктивныхФоновыхЗаданий);
	ДлительностьАктивныхФоновыхЗаданийИзменена = Ложь;
	СнятьМодифицированностьПриНеобходимости();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьМаксимальноеКоличествоФоновыхCOMСоединений(Команда)
	СохранитьМаксимальноеКоличествоФоновыхCOMСоединенийНаСервере(МаксимальноеКоличествоФоновыхCOMСоединений);
	МаксимальноеКоличествоФоновыхCOMСоединенийИзменено = Ложь;
	СнятьМодифицированностьПриНеобходимости();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьАдресСервисаСинхронизацииЕРП(Команда)
	СохранитьАдресСервисаСинхронизацииЕРПНаСервере(АдресСервисаСинхронизацииЕРП);
	АдресСервисаСинхронизацииЕРПИзменен = Ложь;
	СнятьМодифицированностьПриНеобходимости();
КонецПроцедуры

&НаКлиенте
Процедура НастройкаМетодовОбработчиков(Команда)
	ОткрытьФорму("РегистрСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.ФормаСписка", , ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОчередьЗаданий(Команда)
	ОткрытьФорму("РегистрСведений.ЗаданияМенеджераЗаданий.ФормаСписка", , ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Процедура ЗапуститьВыполнениеЗаданийНаСервере()
	РаботаСМенеджеромЗаданийСлужебный.ЗапуститьВыполнениеЗаданий();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОстановитьВыполнениеЗаданийНаСервере()
	РаботаСМенеджеромЗаданийСлужебный.ОстановитьВыполнениеЗаданий();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьВсеЗаданияВОчередиНаСервере()
	РаботаСМенеджеромЗаданийСлужебный.ОтменитьВсеЗаданияВОчереди();
КонецПроцедуры

&НаКлиенте
Процедура СнятьМодифицированностьПриНеобходимости()
	
	ЕстьНеСохраненноеСвойство = 
		ОграничениеНаКоличествоИсполнителейИзменено
			Или ГлубинаХраненияИсторииИзменена
			Или ДлительностьАктивныхФоновыхЗаданийИзменена
			Или МаксимальноеКоличествоФоновыхCOMСоединенийИзменено
			Или АдресСервисаСинхронизацииЕРПИзменен;
	
	Модифицированность = Не ЕстьНеСохраненноеСвойство;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьОграничениеНаКоличествоИсполнителейНаСервере(Знач Значение)
	РегистрыСведений.НастройкиМенеджераЗаданий.УстановитьОграничениеНаКоличествоИсполнителей(
		Значение);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьГлубинуХраненияИсторииНаСервере(Знач Значение)
	РегистрыСведений.НастройкиМенеджераЗаданий.УстановитьГлубинуХраненияИстории(
		Значение);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьДлительностьАктивныхФоновыхЗаданийНаСервере(Знач Значение)
	РегистрыСведений.НастройкиМенеджераЗаданийCOMСоединений.УстановитьДлительностьАктивныхФоновыхЗаданий(
		Значение);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьМаксимальноеКоличествоФоновыхCOMСоединенийНаСервере(Знач Значение)
	РегистрыСведений.НастройкиМенеджераЗаданийCOMСоединений.УстановитьМаксимальноеКоличествоФоновыхCOMСоединений(
		Значение);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьАдресСервисаСинхронизацииЕРПНаСервере(Знач Значение)
	РегистрыСведений.НастройкиИнтеграцииСERP.УстановитьАдресСервисаСинхронизацииЕРП(
		Значение);
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияОбновленияСостояния()
	ОбновитьСостояниеМенеджераЗаданий(Истина);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеМенеджераЗаданий(ОбновлятьДанныеПоИсполнителямИЗаданиям)
	
	Отбор = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.МенеджерЗаданий);
	НайденныеРегламентныеЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);
	
	Если НайденныеРегламентныеЗадания.ВГраница() = -1 Тогда
		МенеджерЗапущен = Ложь;
		Возврат;
	КонецЕсли;
	
	РегламентноеЗадание = НайденныеРегламентныеЗадания.Получить(0);
	МенеджерЗапущен = РегламентноеЗадание.Использование;
	
	Если ОбновлятьДанныеПоИсполнителямИЗаданиям Тогда
		 ОбновитьДанныеПоИсполнителямИЗаданиям();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеПоИсполнителямИЗаданиям()
	
	Сведения = РаботаСМенеджеромЗаданийСлужебный.СведенияОбИсполнителяхИЗаданиях();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Сведения);
	
КонецПроцедуры

#КонецОбласти
