// Максимальное количество одновременных заданий по обработчикам заданий.
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Максимальное количество одновременных заданий по обработчикам заданий:
//   * Ключ - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений
//   * Значение - Структура:
//     ** МаксимальноеКоличествоОдновременныхЗаданий - Число
//
Функция МаксимальноеКоличествоОдновременныхЗаданийПоОбработчикамЗаданий() Экспорт
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	
	Результат = Новый Соответствие;
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Настройки = Новый Структура;
		Настройки.Вставить("МаксимальноеКоличествоОдновременныхЗаданий", Запись.МаксимальноеКоличествоОдновременныхЗаданий);
		Результат.Вставить(Запись.ОбработчикЗадания, Настройки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
