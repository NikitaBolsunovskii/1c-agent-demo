// Значения настроек.
// 
// Возвращаемое значение:
//  Структура - Значения настроек:
// * АдресСервисаСинхронизацииЕРП - Строка
//
Функция ЗначенияНастроек() Экспорт
	
	АдресСервисаСинхронизацииЕРП = "";
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		АдресСервисаСинхронизацииЕРП = МенеджерЗаписи.АдресСервисаСинхронизацииЕРП;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("АдресСервисаСинхронизацииЕРП", АдресСервисаСинхронизацииЕРП);
	Возврат Результат;
	
КонецФункции

// Установить адрес сервиса синхронизации ЕРП.
// 
// Параметры:
//  Значение - Строка - Значение
//
Процедура УстановитьАдресСервисаСинхронизацииЕРП(Значение) Экспорт
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.АдресСервисаСинхронизацииЕРП = Значение;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
