// @strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Добавить параметры выполнения.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
//  ПараметрыВыполнения - Структура: см. РегистрыСведений.ЗаданияCOMСоединений.ПараметрыЗадания
//
Процедура ДобавитьПараметрыВыполнения(УникальныйИдентификатор, ПараметрыВыполнения) Экспорт
	
	НаборЗаписей = ПрочитанныйНаборЗаписейПоУникальномуИдентификатору(УникальныйИдентификатор);
	
	Если НаборЗаписей.Количество() > 0 Тогда
		ПопыткаДобавленияСуществующихПараметровВЖР(УникальныйИдентификатор);
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УникальныйИдентификатор = УникальныйИдентификатор;
	МенеджерЗаписи.ПараметрыВыполнения = Новый ХранилищеЗначения(ПараметрыВыполнения, Новый СжатиеДанных(0));
	МенеджерЗаписи.Записать();
	
	ДобавленыПараметрыВыполненияВЖР(УникальныйИдентификатор);
	
КонецПроцедуры

// Параметры выполнения.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
// 
// Возвращаемое значение:
//  Неопределено, Произвольный - Параметры выполнения или Неопределено
//
Функция ПараметрыВыполнения(УникальныйИдентификатор) Экспорт
	
	НаборЗаписей = ПрочитанныйНаборЗаписейПоУникальномуИдентификатору(УникальныйИдентификатор);
	Если НаборЗаписей.Количество() = 0 Тогда
		НеНайденыПараметрыВыполненияВЖР(УникальныйИдентификатор);
		Возврат Неопределено;
	КонецЕсли;
	
	ПолученыПараметрыВыполненияВЖР(УникальныйИдентификатор);
	Возврат НаборЗаписей[0].ПараметрыВыполнения.Получить();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Универсальные

// Прочитанный набор записей по уникальному идентификатору.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
// 
// Возвращаемое значение:
//  РегистрСведенийНаборЗаписей.ПараметрыВыполненияЗаданийCOMСоединений - Прочитанный набор записей по уникальному идентификатору
//
Функция ПрочитанныйНаборЗаписейПоУникальномуИдентификатору(УникальныйИдентификатор)
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УникальныйИдентификатор.Установить(УникальныйИдентификатор);
	НаборЗаписей.Прочитать();
	Возврат НаборЗаписей;
	
КонецФункции

#КонецОбласти

#Область РаботаСЖурналомРегистрации

// Добавлены параметры выполнения ВЖР.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
//
Процедура ДобавленыПараметрыВыполненияВЖР(УникальныйИдентификатор)
	ИмяСобытия = ИмяКорневогоСобытияЖурналаРегистрации() + "." + СобытияДляЖР().ДобавленыПараметрыВыполнения;
	Комментарий = СтрШаблон("Идентификатор = %1", УникальныйИдентификатор);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Примечание, , , Комментарий);
КонецПроцедуры

// Попытка добавления существующих параметров ВЖР.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
//
Процедура ПопыткаДобавленияСуществующихПараметровВЖР(УникальныйИдентификатор)
	ИмяСобытия = ИмяКорневогоСобытияЖурналаРегистрации() + "." + СобытияДляЖР().ПопыткаДобавленияСуществующихПараметров;
	Комментарий = СтрШаблон("Идентификатор = %1", УникальныйИдентификатор);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , Комментарий);
КонецПроцедуры

// Получены параметры выполнения ВЖР.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
//
Процедура ПолученыПараметрыВыполненияВЖР(УникальныйИдентификатор)
	ИмяСобытия = ИмяКорневогоСобытияЖурналаРегистрации() + "." + СобытияДляЖР().ПолученыПараметрыВыполнения;
	Комментарий = СтрШаблон("Идентификатор = %1", УникальныйИдентификатор);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Примечание, , , Комментарий);
КонецПроцедуры

// Не найдены параметры выполнения ВЖР.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
//
Процедура НеНайденыПараметрыВыполненияВЖР(УникальныйИдентификатор)
	ИмяСобытия = ИмяКорневогоСобытияЖурналаРегистрации() + "." + СобытияДляЖР().НеНайденыПараметрыВыполнения;
	Комментарий = СтрШаблон("Идентификатор = %1", УникальныйИдентификатор);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , Комментарий);
КонецПроцедуры

// Имя корневого события журнала регистрации.
// 
// Возвращаемое значение:
//  Строка - Имя корневого события журнала регистрации
//
Функция ИмяКорневогоСобытияЖурналаРегистрации()
	Возврат "Параметры выполнения заданий COM Соединений";
КонецФункции

// События для ЖР.
// 
// Возвращаемое значение:
//  Структура:
//   * ПопыткаДобавленияСуществующихПараметров - Строка
//   * ДобавленыПараметрыВыполнения - Строка
//   * ПолученыПараметрыВыполнения - Строка
//   * НеНайденыПараметрыВыполнения - Строка
//  
Функция СобытияДляЖР()
	
	Результат = Новый Структура;
	Результат.Вставить("ПопыткаДобавленияСуществующихПараметров", "Попытка добавления существующих параметров выполнения");
	Результат.Вставить("ДобавленыПараметрыВыполнения", "Параметры выполнения заданий добавлены");
	Результат.Вставить("ПолученыПараметрыВыполнения", "Получение параметров выполнения");
	Результат.Вставить("НеНайденыПараметрыВыполнения", "Не найдены параметры выполнения по уникальному идентификатору");
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
