#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Значения настроек.
// 
// Возвращаемое значение:
//  Структура - Значения настроек:
// * ДлительностьАктивныхФоновыхЗаданий - Число
// * МаксимальноеКоличествоФоновыхCOMСоединений - Число
//
Функция ЗначенияНастроек() Экспорт
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Прочитать();
	ДлительностьАктивныхФоновыхЗаданий = ЗначениеПоУмолчаниюДлительностьАктивныхФоновыхЗаданий();
	МаксимальноеКоличествоФоновыхCOMСоединений = ЗначениеПоУмолчаниюМаксимальноеКоличествоФоновыхCOMСоединений();
	Если МенеджерЗаписи.Выбран() Тогда
		ДлительностьАктивныхФоновыхЗаданий = МенеджерЗаписи.ДлительностьАктивныхФоновыхЗаданий;
		МаксимальноеКоличествоФоновыхCOMСоединений = МенеджерЗаписи.МаксимальноеКоличествоФоновыхCOMСоединений;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДлительностьАктивныхФоновыхЗаданий", ДлительностьАктивныхФоновыхЗаданий);
	Результат.Вставить("МаксимальноеКоличествоФоновыхCOMСоединений", МаксимальноеКоличествоФоновыхCOMСоединений);
	Возврат Результат;
	
КонецФункции

// Установить длительность активных фоновых заданий.
// 
// Параметры:
//  Значение - Число - Значение
//
Процедура УстановитьДлительностьАктивныхФоновыхЗаданий(Значение) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных();
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.НастройкиМенеджераЗаданийCOMСоединений");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		МенеджерЗаписи = СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.МаксимальноеКоличествоФоновыхCOMСоединений = 
				ЗначениеПоУмолчаниюМаксимальноеКоличествоФоновыхCOMСоединений();
		КонецЕсли;
		МенеджерЗаписи.ДлительностьАктивныхФоновыхЗаданий = Значение;
		МенеджерЗаписи.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"Настройки менеджера заданий COM соединений", 
			УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки);
		ВызватьИсключение "Не удалось выполнить установку значения настройки. См. Журнал регистрации.";
	КонецПопытки;
	
КонецПроцедуры

// Установить максимальное количество фоновых COMСоединений.
// 
// Параметры:
//  Значение - Число - Значение
