		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		МенеджерЗаписи = СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.ДлительностьАктивныхФоновыхЗаданий = 
				ЗначениеПоУмолчаниюДлительностьАктивныхФоновыхЗаданий();
		КонецЕсли;
		МенеджерЗаписи.МаксимальноеКоличествоФоновыхCOMСоединений = Значение;
		МенеджерЗаписи.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"Настройки менеджера заданий COM соединений", 
			УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки);
		ВызватьИсключение "Не удалось выполнить установку значения настройки. См. Журнал регистрации.";
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значение по умолчанию длительность активных фоновых заданий.
// Значение указывается в часах.
// 
// Возвращаемое значение:
//  Число - Значение по умолчанию длительность активных фоновых заданий
//
Функция ЗначениеПоУмолчаниюДлительностьАктивныхФоновыхЗаданий()
	Возврат 1;
КонецФункции

// Значение по умолчанию максимальное количество фоновых COM соединений.
// 
// Возвращаемое значение:
//  Число - Значение по умолчанию максимальное количество фоновых COM соединений
//
Функция ЗначениеПоУмолчаниюМаксимальноеКоличествоФоновыхCOMСоединений()
	Возврат 5;
