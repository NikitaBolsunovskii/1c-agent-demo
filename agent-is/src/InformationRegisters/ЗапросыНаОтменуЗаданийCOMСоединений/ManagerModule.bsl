// @strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Добавить запрос отмены задания.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
//
Процедура ДобавитьЗапросОтменыЗадания(УникальныйИдентификатор) Экспорт
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УникальныйИдентификаторЗадания = УникальныйИдентификатор;
	МенеджерЗаписи.ДатаДобавленияЗапроса = ТекущаяДатаСеанса();
	МенеджерЗаписи.Записать(Истина);
	
	ДобавленЗапросНаОтменуВЖР(УникальныйИдентификатор);
	
КонецПроцедуры

// Требуется отменить выполнение задания.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
// 
// Возвращаемое значение:
//  Булево - Требуется отменить выполнение задания
//
Функция ТребуетсяОтменитьВыполнениеЗадания(УникальныйИдентификатор) Экспорт
	
	НаборЗаписей = ПрочитанныйНаборЗаписейПоУникальномуИдентификатору(УникальныйИдентификатор);	
	Возврат НаборЗаписей.Количество() <> 0;
	
КонецФункции

// Отметить успешную отмену задания.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
//
Процедура ОтметитьУспешнуюОтменуЗадания(УникальныйИдентификатор) Экспорт
	
	НаборЗаписей = ПрочитанныйНаборЗаписейПоУникальномуИдентификатору(УникальныйИдентификатор);	
	
	Если НаборЗаписей.Количество() = 0 Тогда
		НеНайденаЗаписьВРегистреВЖР(УникальныйИдентификатор);
		ВызватьИсключение СобытияДляЖР().НеНайденаЗаписьВРегистре;
	КонецЕсли;

	НаборЗаписей[0].ЗаданиеБылоОтмененоЗапросом = Истина;
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Универсальные

// Прочитанный набор записей по уникальному идентификатору.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
// 
// Возвращаемое значение:
//  РегистрСведенийНаборЗаписей.ЗапросыНаОтменуЗаданийCOMСоединений - Прочитанный набор записей по уникальному идентификатору
//
Функция ПрочитанныйНаборЗаписейПоУникальномуИдентификатору(УникальныйИдентификатор)
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УникальныйИдентификаторЗадания.Установить(УникальныйИдентификатор);
	НаборЗаписей.Прочитать();
	Возврат НаборЗаписей;
	
КонецФункции

#КонецОбласти

#Область РаботаСЖурналомРегистрации

// Добавлен запрос на отмену ВЖР.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
//
Процедура ДобавленЗапросНаОтменуВЖР(УникальныйИдентификатор)
	ИмяСобытия = ИмяКорневогоСобытияЖурналаРегистрации() + "." + СобытияДляЖР().ДобавленЗапросНаОтмену;
	Комментарий = СтрШаблон("Идентификатор = %1", УникальныйИдентификатор);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Примечание, , , Комментарий);
КонецПроцедуры

// Не найдена запись в регистре ВЖР.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
//
Процедура НеНайденаЗаписьВРегистреВЖР(УникальныйИдентификатор)
	ИмяСобытия = ИмяКорневогоСобытияЖурналаРегистрации() + "." + СобытияДляЖР().НеНайденаЗаписьВРегистре;
	Комментарий = СтрШаблон("Идентификатор = %1", УникальныйИдентификатор);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , Комментарий);
КонецПроцедуры

// Имя корневого события журнала регистрации.
// 
// Возвращаемое значение:
//  Строка - Имя корневого события журнала регистрации
//
Функция ИмяКорневогоСобытияЖурналаРегистрации()
	Возврат "Запросы на отмену заданий COM Соединений";
КонецФункции

// События для ЖР.
// 
// Возвращаемое значение:
//  Структура:
//   * ДобавленЗапросНаОтмену - Строка
//   * НеНайденаЗаписьВРегистре - Строка
//  
Функция СобытияДляЖР()
	
	Результат = Новый Структура;
	Результат.Вставить("ДобавленЗапросНаОтмену", "Был добавлен запрос на отмену задания");
	Результат.Вставить("НеНайденаЗаписьВРегистре", "Запись в регистре сведений не найдена");
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
