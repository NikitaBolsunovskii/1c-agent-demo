// @strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Новый менеджер записи.
// Предварительно заполняется переданными параметрами, если КлючЗадания = Неопределено,
// тогда генерируется новый уникальный идентификатор.
// 
// Параметры:
//  ИмяМетода - Строка - Имя метода
//  Параметры - Структура - Параметры
//  КлючЗадания - Неопределено, Строка - Ключ задания
// 
// Возвращаемое значение:
//  РегистрСведенийМенеджерЗаписи.ЗаданияМенеджераЗаданий - новый менеджер записи
//
Функция НовыйМенеджерЗаписи(ИмяМетода, Параметры, КлючЗадания = Неопределено) Экспорт
	
	Результат = СоздатьМенеджерЗаписи();
	
	Если КлючЗадания = Неопределено Тогда
		КлючЗаданияВнутренний = Новый УникальныйИдентификатор();
	Иначе
		КлючЗаданияВнутренний = Новый УникальныйИдентификатор(КлючЗадания);
	КонецЕсли;
	
	Параметры.Вставить("КлючЗадания", КлючЗаданияВнутренний);
	
	Результат.Период = ТекущаяДатаСеанса();
	Результат.Ключ = КлючЗаданияВнутренний;
	Результат.ИмяМетода = ИмяМетода;
	Результат.Параметры = Новый ХранилищеЗначения(Параметры, Новый СжатиеДанных(0));
	
	Возврат Результат;
	
КонецФункции

// Взять задание в работу.
// 
// Параметры:
//  КлючЗадания - УникальныйИдентификатор - Ключ задания
//  УникальныйИдентификаторИсполнителя - УникальныйИдентификатор - Уникальный идентификатор исполнителя
// 
// Возвращаемое значение:
//  Неопределено, Структура - Взять задание в работу:
// * ИмяМетода - Строка - 
// * Параметры - Произвольный - 
//
Функция ВзятьЗаданиеВРаботу(КлючЗадания, УникальныйИдентификаторИсполнителя) Экспорт
	
	ДеталиЗадания = Неопределено;
	НаборЗаписей = ПрочитанныйНаборЗаписейПоКлючуЗадания(КлючЗадания);
	Если НаборЗаписей.Количество() = 1 Тогда
		Задание = НаборЗаписей.Получить(0);
		СостоянияДляВзятияВРаботу = СостоянияДляВзятияВРаботу();
		Если СостоянияДляВзятияВРаботу.Найти(Задание.Состояние) = Неопределено Тогда
			Возврат ДеталиЗадания;
		КонецЕсли;
		ДеталиЗадания = Новый Структура;
		ДеталиЗадания.Вставить("ИмяМетода", Задание.ИмяМетода);
		ДеталиЗадания.Вставить("Параметры", Задание.Параметры.Получить());
		
		Задание.КлючИсполнителя = УникальныйИдентификаторИсполнителя;
		Задание.Состояние = Перечисления.СостоянияЗаданийМенеджераЗаданий.Выполняется;
		Задание.НачалоВыполнения = ТекущаяДатаСеанса();
		Задание.КоличествоПопытокВыполнения = Задание.КоличествоПопытокВыполнения + 1;
		
		НаборЗаписей.Записать();
		
	КонецЕсли;
	
	Возврат ДеталиЗадания;
	
КонецФункции

// Отметить завершение задания.
// 
// Параметры:
//  КлючЗадания - УникальныйИдентификатор - Ключ задания
//  РезультатВыполнения - Произвольный - Результат выполнения
//
Процедура ОтметитьЗавершениеЗадания(КлючЗадания, РезультатВыполнения) Экспорт
	
	НаборЗаписей = ПрочитанныйНаборЗаписейПоКлючуЗадания(КлючЗадания);
	Если НаборЗаписей.Количество() = 1 Тогда
		Задание = НаборЗаписей[0];
		Задание.Состояние = Перечисления.СостоянияЗаданийМенеджераЗаданий.Выполнено;
		Задание.ЗавершениеВыполнения = ТекущаяДатаСеанса();
		Задание.РезультатВыполнения = Новый ХранилищеЗначения(РезультатВыполнения, Новый СжатиеДанных(0));
		НаборЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры

// Освободить задания без активных исполнителей.
// 
// Параметры:
//  НастройкиМетодовОбработчиков см. РегистрыСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.ПоИменамМетодов
//  УИДыАктивныхИсполнителей - Массив Из УникальныйИдентификатор - УИДы активных исполнителей
//
Процедура ОсвободитьЗаданияБезАктивныхИсполнителей(НастройкиМетодовОбработчиков, УИДыАктивныхИсполнителей) Экспорт
	
	ПустойУникальныйИдентификатор = ПустойУникальныйИдентификатор();
	
	Выборка = ВыборкаЗаданияБезАктивныхИсполнителей(УИДыАктивныхИсполнителей);
	Пока Выборка.Следующий() Цикл
		
		МенеджерЗаписи = СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		МенеджерЗаписи.КлючИсполнителя = ПустойУникальныйИдентификатор;
		
		НастройкаМетодаОбработчика = 
			НастройкаМетодаОбработчикаПоИмениМетода(
				НастройкиМетодовОбработчиков,
				Выборка.ИмяМетода);
		
		Если МенеджерЗаписи.НачалоВыполнения + НастройкаМетодаОбработчика.ПаузаПередНовойПопыткой > ТекущаяДатаСеанса() Тогда
			МенеджерЗаписи.Состояние = Перечисления.СостоянияЗаданийМенеджераЗаданий.НаПаузе;
		Иначе
			МенеджерЗаписи.Состояние = Перечисления.СостоянияЗаданийМенеджераЗаданий.Ожидает;
		КонецЕсли;
		
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

// Отменить задания с достигнутым лимитом по максимальному количеству попыток выполнения.
// 
Процедура ОтменитьЗаданияСДостигнутымЛимитомПоМаксимальномуКоличествуПопытокВыполнения() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданияМенеджераЗаданий.Ключ КАК Ключ
		|ИЗ
		|	РегистрСведений.ЗаданияМенеджераЗаданий КАК ЗаданияМенеджераЗаданий
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиМетодовОбработчиковМенеджераЗаданий КАК НастройкиМетодовОбработчиков
		|		ПО ЗаданияМенеджераЗаданий.ИмяМетода = НастройкиМетодовОбработчиков.ИмяМетода
		|ГДЕ
		|	ЗаданияМенеджераЗаданий.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияЗаданийМенеджераЗаданий.Ожидает),
		|		ЗНАЧЕНИЕ(Перечисление.СостоянияЗаданийМенеджераЗаданий.НаПаузе))
		|	И НастройкиМетодовОбработчиков.МаксимальноеКоличествоПопытокВыполнения > 0
		|	И
		|		ЗаданияМенеджераЗаданий.КоличествоПопытокВыполнения >= НастройкиМетодовОбработчиков.МаксимальноеКоличествоПопытокВыполнения";
	КлючиЗаданийДляОтмены = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ключ"); // Массив Из УникальныйИдентификатор
	Для Каждого Ключ Из КлючиЗаданийДляОтмены Цикл // УникальныйИдентификатор
		ОтменитьЗадание(Ключ);
	КонецЦикла;
	
КонецПроцедуры

// Снять задания с паузы.
// 
// Параметры:
//  НастройкиМетодовОбработчиков см. РегистрыСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.ПоИменамМетодов
//
Процедура СнятьЗаданияСПаузы(НастройкиМетодовОбработчиков) Экспорт
	
	Состояния = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		Перечисления.СостоянияЗаданийМенеджераЗаданий.НаПаузе);
	КлючиЗаданий = КлючиЗаданийВСостояниях(Состояния);
	
	Для Каждого Ключ Из КлючиЗаданий Цикл
		СнятьСПаузыЗадание(Ключ, НастройкиМетодовОбработчиков);
	КонецЦикла;
	
КонецПроцедуры

// Отменить все задания в очереди.
//
Процедура ОтменитьВсеЗаданияВОчереди() Экспорт
	
	СостоянияПоддерживающиеОтмену = СостоянияПоддерживающиеОтмену();
	КлючиЗаданий = КлючиЗаданийВСостояниях(СостоянияПоддерживающиеОтмену);
	Для Каждого Ключ Из КлючиЗаданий Цикл
		ОтменитьЗадание(Ключ);
	КонецЦикла;
	
КонецПроцедуры

// Количество заданий в очереди.
// 
// Возвращаемое значение:
//  Число
//  
Функция КоличествоЗаданийВОчереди() Экспорт
	
	Состояния = СостоянияДляВзятияВРаботу();
	Возврат КоличествоЗаданийВСостояниях(Состояния);
	
КонецФункции

// Количество заданий на паузе.
// 
// Возвращаемое значение:
//  Число
//  
Функция КоличествоЗаданийНаПаузе() Экспорт
	
	Состояния = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		Перечисления.СостоянияЗаданийМенеджераЗаданий.НаПаузе);
	Возврат КоличествоЗаданийВСостояниях(Состояния);
	
КонецФункции

// Ключи заданий из очереди.
// 
// Для заданий в состоянии "ОжидаетВыделенногоИсполнителя" делаем допущение, что
// если за 60 секунд выделенный исполнитель не запустился и не взял задание в работу, то
// он уже не запустится никогда (например, проблемы с rphost)
// Обрабатываем такие задания в общем порядке очереди
// 
// Параметры:
//  КоличествоЗаданий - Число - Количество заданий
// 
// Возвращаемое значение:
//  Массив Из УникальныйИдентификатор
//
Функция КлючиЗаданийИзОчереди(КоличествоЗаданий) Экспорт
	
	Выборка = ВыборкаЗаданияИзОчереди();
	ИнформацияПоОграничениямНаКоличествоИсполнителейМетодовОбработчиков = 
		ИнформацияПоОграничениямНаКоличествоИсполнителейМетодовОбработчиков();
	ВыбранныеКлючи = Новый Массив; // Массив Из УникальныйИдентификатор
	Пока Выборка.Следующий() Цикл
		ДеталиПоОграничениям = ИнформацияПоОграничениямНаКоличествоИсполнителейМетодовОбработчиков.Получить(Выборка.ИмяМетода);
		Если ДеталиПоОграничениям = Неопределено Тогда
			ВыбранныеКлючи.Добавить(Выборка.Ключ);
		ИначеЕсли ДеталиПоОграничениям.МаксимальноеКоличествоИсполнителей > ДеталиПоОграничениям.КоличествоАктивныхЗаданий Тогда
			ВыбранныеКлючи.Добавить(Выборка.Ключ);
			ДеталиПоОграничениям.КоличествоАктивныхЗаданий = ДеталиПоОграничениям.КоличествоАктивныхЗаданий + 1;
		КонецЕсли;
		
		Если ВыбранныеКлючи.Количество() = КоличествоЗаданий Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВыбранныеКлючи;
	
КонецФункции

// Ключи всех не выполненных заданий.
// 
// Возвращаемое значение:
//  Массив Из УникальныйИдентификатор - Ключи всех не выполненных заданий
//
Функция КлючиВсехНеВыполненныхЗаданий() Экспорт
	
	Состояния = СостоянияПоддерживающиеОтмену();
	Состояния.Добавить(Перечисления.СостоянияЗаданийМенеджераЗаданий.Выполняется);
	Возврат КлючиЗаданийВСостояниях(Состояния);
	
КонецФункции

// Сократить история выполнения заданий.
// 
// Параметры:
//  ТребуемаяГлубинаИсторииВДнях - Число - Требуемая глубина истории в днях
//
Процедура СократитьИсторияВыполненияЗаданий(ТребуемаяГлубинаИсторииВДнях) Экспорт
	
	ОдинДеньВСекундах = 24 * 60 * 60;
	МинимальныйПериодИстории = ТекущаяДатаСеанса() - ОдинДеньВСекундах * ТребуемаяГлубинаИсторииВДнях;
	
	Выборка = ВыборкаВыполненныеИОтмененныеЗаданияРанееМинимальногоПериода(МинимальныйПериодИстории);
	НаборЗаписей = СоздатьНаборЗаписей();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей.Отбор.Ключ.Установить(Выборка.Ключ);
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Состояние задания.
// 
// Параметры:
//  КлючЗадания - УникальныйИдентификатор - Ключ задания
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.СостоянияЗаданийМенеджераЗаданий, Неопределено - состояние задание или Неопределено
//  
Функция СостояниеЗадания(КлючЗадания) Экспорт
	
	Результат = Неопределено;
	Выборка = ВыборкаСостояниеЗадания(КлючЗадания);
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Состояние;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Универсальные

// Пустой уникальный идентификатор.
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Пустой уникальный идентификатор
//
Функция ПустойУникальныйИдентификатор()
	
	Возврат Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	
КонецФункции

// Прочитанный набор записей по ключу задания.
// 
// Параметры:
//  КлючЗадания - УникальныйИдентификатор - Ключ задания
// 
// Возвращаемое значение:
//  РегистрСведенийНаборЗаписей.ЗаданияМенеджераЗаданий - Набор записей по ключу задания
//
Функция ПрочитанныйНаборЗаписейПоКлючуЗадания(КлючЗадания)
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ключ.Установить(КлючЗадания);
	НаборЗаписей.Прочитать();
	Возврат НаборЗаписей;
	
КонецФункции

// Настройка метода обработчика по имени метода.
// 
// Параметры:
//  НастройкиМетодовОбработчиков см. РегистрыСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.ПоИменамМетодов
//  ИмяМетода - Строка - Имя метода
// 
// Возвращаемое значение:
//  Структура - Настройка метода обработчика по имени метода:
// * МаксимальноеКоличествоИсполнителей - Число
// * МаксимальноеКоличествоПопытокВыполнения - Число
// * ПаузаПередНовойПопыткой - Число
// * Приоритет - Число
//
Функция НастройкаМетодаОбработчикаПоИмениМетода(НастройкиМетодовОбработчиков, ИмяМетода)
	
	НастройкаМетодаОбработчика = НастройкиМетодовОбработчиков.Получить(ИмяМетода);
	Если НастройкаМетодаОбработчика = Неопределено Тогда
		НастройкаМетодаОбработчика = РегистрыСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.ПоУмолчанию();
	КонецЕсли;
	
	Возврат НастройкаМетодаОбработчика;
	
КонецФункции

#КонецОбласти

#Область ОтборЗаданий

// Выборка задания без активных исполнителей.
// 
// Параметры:
//  УникальныеИдентификаторыИсполнителей - Массив из УникальныйИдентификатор - Уникальные идентификаторы активных исполнителей
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Задания без активных исполнителей:
//  * Период - Дата
//  * Ключ см. РегистрСведений.ЗаданияМенеджераЗаданий.Ключ
//  * ИмяМетода см. РегистрСведений.ЗаданияМенеджераЗаданий.ИмяМетода
//  * Параметры см. РегистрСведений.ЗаданияМенеджераЗаданий.Параметры
//  * НачалоВыполнения см. РегистрСведений.ЗаданияМенеджераЗаданий.НачалоВыполнения
//  * КоличествоПопытокВыполнения см. РегистрСведений.ЗаданияМенеджераЗаданий.КоличествоПопытокВыполнения
// 
Функция ВыборкаЗаданияБезАктивныхИсполнителей(УникальныеИдентификаторыИсполнителей)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаданияМенеджераЗаданий.Период КАК Период,
		|	ЗаданияМенеджераЗаданий.Ключ КАК Ключ,
		|	ЗаданияМенеджераЗаданий.ИмяМетода КАК ИмяМетода,
		|	ЗаданияМенеджераЗаданий.Параметры КАК Параметры,
		|	ЗаданияМенеджераЗаданий.НачалоВыполнения КАК НачалоВыполнения,
		|	ЗаданияМенеджераЗаданий.КоличествоПопытокВыполнения КАК КоличествоПопытокВыполнения
		|ИЗ
		|	РегистрСведений.ЗаданияМенеджераЗаданий КАК ЗаданияМенеджераЗаданий
		|ГДЕ
		|	ЗаданияМенеджераЗаданий.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗаданийМенеджераЗаданий.Выполняется)
		|	И НЕ ЗаданияМенеджераЗаданий.КлючИсполнителя В (&МассивУИИсполнителей)";
	Запрос.УстановитьПараметр("МассивУИИсполнителей", УникальныеИдентификаторыИсполнителей);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции

// Ключи заданий в состояниях.
// 
// Параметры:
//  Состояния - Массив Из ПеречислениеСсылка.СостоянияЗаданийМенеджераЗаданий
// 
// Возвращаемое значение:
//  Массив Из УникальныйИдентификатор
//
Функция КлючиЗаданийВСостояниях(Состояния)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданияМенеджераЗаданий.Ключ КАК Ключ
		|ИЗ
		|	РегистрСведений.ЗаданияМенеджераЗаданий КАК ЗаданияМенеджераЗаданий
		|ГДЕ
		|	ЗаданияМенеджераЗаданий.Состояние В (&Состояния)";
	Запрос.УстановитьПараметр("Состояния", Состояния);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ключ");
	
КонецФункции

// Количество заданий в состояниях.
// 
// Параметры:
//  Состояния - Массив Из ПеречислениеСсылка.СостоянияЗаданийМенеджераЗаданий
// 
// Возвращаемое значение:
//  Число 
//
Функция КоличествоЗаданийВСостояниях(Состояния)
	
	Результат = ТаблицаКоличествоЗаданийВСостояниях(Состояния);
	Возврат Результат[0].Количество;
	
КонецФункции

// Таблица количество заданий в состояниях.
// 
// Параметры:
//  Состояния - Массив Из ПеречислениеСсылка.СостоянияЗаданийМенеджераЗаданий
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица количество заданий в состояних:
//  * Количество - Число
//
Функция ТаблицаКоличествоЗаданийВСостояниях(Состояния)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.ЗаданияМенеджераЗаданий КАК ЗаданияМенеджераЗаданий
		|ГДЕ
		|	ЗаданияМенеджераЗаданий.Состояние В (&Состояния)";
	Запрос.УстановитьПараметр("Состояния", Состояния);
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
	
КонецФункции

// Выборка задания из очереди.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка задания из очереди:
//   * Ключ - УникальныйИдентификатор
//   * ИмяМетода - Строка
//
Функция ВыборкаЗаданияИзОчереди()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаданияМенеджераЗаданий.Ключ КАК Ключ,
		|	ЗаданияМенеджераЗаданий.ИмяМетода КАК ИмяМетода
		|ИЗ
		|	РегистрСведений.ЗаданияМенеджераЗаданий КАК ЗаданияМенеджераЗаданий
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиМетодовОбработчиковМенеджераЗаданий КАК
		|			НастройкиМетодовОбработчиковМенеджераЗаданий
		|		ПО ЗаданияМенеджераЗаданий.ИмяМетода = НастройкиМетодовОбработчиковМенеджераЗаданий.ИмяМетода
		|ГДЕ
		|	ЗаданияМенеджераЗаданий.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗаданийМенеджераЗаданий.Ожидает)
		|	ИЛИ ЗаданияМенеджераЗаданий.Период < &ПериодМинутуНазад
		|	И
		|		ЗаданияМенеджераЗаданий.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗаданийМенеджераЗаданий.ОжидаетВыделенногоИсполнителя)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЕСТЬNULL(НастройкиМетодовОбработчиковМенеджераЗаданий.Приоритет, 0) УБЫВ,
		|	ЗаданияМенеджераЗаданий.КоличествоПопытокВыполнения,
		|	ЗаданияМенеджераЗаданий.Период";
	ОднаМинута = 60;
	Запрос.УстановитьПараметр("ПериодМинутуНазад",  ТекущаяДатаСеанса() - ОднаМинута);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Выборка количество активных заданий по именам методов.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка количество активных заданий по именам методов:
//   * ИмяМетода - Строка
//   * КоличествоАктивныхЗаданий - Число
//
Функция ВыборкаКоличествоАктивныхЗаданийПоИменамМетодов()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаданияМенеджераЗаданий.ИмяМетода КАК ИмяМетода,
		|	КОЛИЧЕСТВО(*) КАК КоличествоАктивныхЗаданий
		|ИЗ
		|	РегистрСведений.ЗаданияМенеджераЗаданий КАК ЗаданияМенеджераЗаданий
		|ГДЕ
		|	ЗаданияМенеджераЗаданий.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗаданийМенеджераЗаданий.Выполняется)
		|СГРУППИРОВАТЬ ПО
		|	ЗаданияМенеджераЗаданий.ИмяМетода";
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Информация по ограничениям на количество исполнителей методов обработчиков.
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Информация по ограничениям на количество исполнителей методов обработчиков:
//   * Ключ - Строка - Имя метода
//   * Значение см. ДеталиПоОграничениемНаКоличествоИсполнителей
//
Функция ИнформацияПоОграничениямНаКоличествоИсполнителейМетодовОбработчиков()
	
	Результат = КонструкторИнформацииПоОграничениямНаКоличествоИсполнителейМетодовОбработчиков();
	
	МаксимальноеКоличествоИсполнителейПоИменамМетодов = 
		РегистрыСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.МаксимальноеКоличествоИсполнителейПоИменамМетодов();
	
	Для Каждого МаксимумПопытокМетода Из МаксимальноеКоличествоИсполнителейПоИменамМетодов Цикл
		ДеталиПоОграничениям = ДеталиПоОграничениемНаКоличествоИсполнителей();
		ДеталиПоОграничениям.МаксимальноеКоличествоИсполнителей = МаксимумПопытокМетода.Значение;
		ДеталиПоОграничениям.КоличествоАктивныхЗаданий = 0;
		Результат.Вставить(МаксимумПопытокМетода.Ключ, ДеталиПоОграничениям);
	КонецЦикла;
	
	Выборка = ВыборкаКоличествоАктивныхЗаданийПоИменамМетодов();
	Пока Выборка.Следующий() Цикл
		
		ДеталиПоОграничениям = Результат.Получить(Выборка.ИмяМетода);
		Если ДеталиПоОграничениям <> Неопределено Тогда
			ДеталиПоОграничениям.КоличествоАктивныхЗаданий = Выборка.КоличествоАктивныхЗаданий;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Выборка выполненные и отмененные задания ранее минимального периода.
// 
// Параметры:
//  МинимальныйПериод - Дата - Минимальный период
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка выполненные и отмененные задания ранее минимального периода:
//   * Ключ - УникальныйИдентификатор
//
Функция ВыборкаВыполненныеИОтмененныеЗаданияРанееМинимальногоПериода(МинимальныйПериод)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаданияМенеджераЗаданий.Ключ КАК Ключ
		|ИЗ
		|	РегистрСведений.ЗаданияМенеджераЗаданий КАК ЗаданияМенеджераЗаданий
		|ГДЕ
		|	ЗаданияМенеджераЗаданий.Период < &МинимальныйПериодИстории
		|	И ЗаданияМенеджераЗаданий.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияЗаданийМенеджераЗаданий.Выполнено),
		|		ЗНАЧЕНИЕ(Перечисление.СостоянияЗаданийМенеджераЗаданий.Отменено))";
	Запрос.УстановитьПараметр("МинимальныйПериодИстории", МинимальныйПериод);
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Выборка состояние задания.
// 
// Параметры:
//  КлючЗадания - УникальныйИдентификатор - Ключ задания
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка состояние задания:
//  * Состояние - ПеречислениеСсылка.СостоянияЗаданийМенеджераЗаданий
//
Функция ВыборкаСостояниеЗадания(КлючЗадания)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаданияМенеджераЗаданий.Состояние КАК Состояние
		|ИЗ
		|	РегистрСведений.ЗаданияМенеджераЗаданий КАК ЗаданияМенеджераЗаданий
		|ГДЕ
		|	ЗаданияМенеджераЗаданий.Ключ = &КлючЗадания";
	Запрос.УстановитьПараметр("КлючЗадания", КлючЗадания);
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

#КонецОбласти

#Область ДействияСЗаданиями

// Отменить задание.
// 
// Параметры:
//  КлючЗадания - УникальныйИдентификатор - Ключ задания
// 
// Возвращаемое значение:
//  Булево
//
Функция ОтменитьЗадание(КлючЗадания)
	
	Результат = Ложь;
	
	НаборЗаписей = ПрочитанныйНаборЗаписейПоКлючуЗадания(КлючЗадания);
	
	Если НаборЗаписей.Количество() = 1 Тогда
		Задание = НаборЗаписей[0];
		СостоянияПоддерживающиеОтмену = СостоянияПоддерживающиеОтмену();
		Если СостоянияПоддерживающиеОтмену.Найти(Задание.Состояние) <> Неопределено Тогда
			Задание.Состояние = Перечисления.СостоянияЗаданийМенеджераЗаданий.Отменено;
			Задание.ЗавершениеВыполнения = ТекущаяДатаСеанса();
			НаборЗаписей.Записать();
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

// Снять с паузы задание.
// 
// Параметры:
//  КлючЗадания - УникальныйИдентификатор - Ключ задания
//  НастройкиМетодовОбработчиков см. РегистрыСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.ПоИменамМетодов
// 
// Возвращаемое значение:
//  Булево - Снять с паузы задание
//
Функция СнятьСПаузыЗадание(КлючЗадания, НастройкиМетодовОбработчиков)
	
	Результат = Ложь;
	
	НаборЗаписей = ПрочитанныйНаборЗаписейПоКлючуЗадания(КлючЗадания);
	
	Если НаборЗаписей.Количество() = 1 Тогда
		Задание = НаборЗаписей[0];
		
		НастройкаМетодаОбработчика = 
			НастройкаМетодаОбработчикаПоИмениМетода(
				НастройкиМетодовОбработчиков,
				Задание.ИмяМетода);
		Если Задание.НачалоВыполнения + НастройкаМетодаОбработчика.ПаузаПередНовойПопыткой <= ТекущаяДатаСеанса() Тогда
			Задание.Состояние = Перечисления.СостоянияЗаданийМенеджераЗаданий.Ожидает;
			НаборЗаписей.Записать();
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область НаборыСостояний

// Состояния для взятия в работу.
// 
// Возвращаемое значение:
//  Массив Из ПеречислениеСсылка.СостоянияЗаданийМенеджераЗаданий
//
Функция СостоянияДляВзятияВРаботу()
	
	Результат = Новый Массив; // Массив Из ПеречислениеСсылка.СостоянияЗаданийМенеджераЗаданий
	Результат.Добавить(Перечисления.СостоянияЗаданийМенеджераЗаданий.Ожидает);
	Результат.Добавить(Перечисления.СостоянияЗаданийМенеджераЗаданий.ОжидаетВыделенногоИсполнителя);
	Возврат Результат;
	
КонецФункции

// Состояния поддерживающие отмену.
// 
// Возвращаемое значение:
//  Массив Из ПеречислениеСсылка.СостоянияЗаданийМенеджераЗаданий
//
Функция СостоянияПоддерживающиеОтмену()
	
	Результат = СостоянияДляВзятияВРаботу();
	Результат.Добавить(Перечисления.СостоянияЗаданийМенеджераЗаданий.НаПаузе);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Конструкторы

// Детали по ограничением на количество исполнителей.
// 
// Возвращаемое значение:
//  Структура - Детали по ограничением на количество исполнителей:
// * МаксимальноеКоличествоИсполнителей - Число
// * КоличествоАктивныхЗаданий - Число
//
Функция ДеталиПоОграничениемНаКоличествоИсполнителей()
	
	Результат = Новый Структура;
	Результат.Вставить("МаксимальноеКоличествоИсполнителей", 0);
	Результат.Вставить("КоличествоАктивныхЗаданий", 0);
	Возврат Результат;
	
КонецФункции

// Конструктор информации по ограничениям на количество исполнителей методов обработчиков.
// 
// Возвращаемое значение:
