Функция Прочитать() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КаталогиИсключенияРазмещенияИнформационныхБаз.Путь КАК Путь
		|ИЗ
		|	РегистрСведений.КаталогиИсключенияРазмещенияИнформационныхБаз КАК КаталогиИсключенияРазмещенияИнформационныхБаз";
	Данные = Запрос.Выполнить().Выгрузить();
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(Данные);
	
КонецФункции

