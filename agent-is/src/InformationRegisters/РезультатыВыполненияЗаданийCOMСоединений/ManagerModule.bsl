// @strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Сохранить результат выполнения.
// 
// Параметры:
//  УникальныйИдентификаторЗадания - УникальныйИдентификатор - Уникальный идентификатор задания
//  РезультатВыполнения - Произвольный - Результат выполнения
//
Процедура СохранитьРезультатВыполнения(УникальныйИдентификаторЗадания, РезультатВыполнения) Экспорт
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
		
	МенеджерЗаписи.УникальныйИдентификаторЗадания = УникальныйИдентификаторЗадания;
	МенеджерЗаписи.РезультатВыполнения = Новый ХранилищеЗначения(РезультатВыполнения, Новый СжатиеДанных(0));
	МенеджерЗаписи.ДатаДобавленияРезультата = ТекущаяДатаСеанса();
	
	// Мы замещаем старый результат, так как для некоторых ситуаций необходимо сохранять промежуточный результат
	МенеджерЗаписи.Записать(Истина);
	РезультатВыполненияЗаданияСохраненВЖР(УникальныйИдентификаторЗадания);	
	
КонецПроцедуры

// Результат выполнения.
// 
// Параметры:
//  УникальныйИдентификаторЗадания - УникальныйИдентификатор - Уникальный идентификатор задания
// 
// Возвращаемое значение:
//  Неопределено, Произвольный - Результат выполнения
//
Функция РезультатВыполнения(УникальныйИдентификаторЗадания) Экспорт
	
	УникальныеИдентификаторыЗаданий = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(УникальныйИдентификаторЗадания);
	РезультатыВыполнения = РезультатыВыполнения(УникальныеИдентификаторыЗаданий);
	
	Если РезультатыВыполнения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РезультатыВыполнения[0]; 
КонецФункции

// Получить результаты выполнения.
// 
// Параметры:
//  УникальныеИдентификаторыЗаданий - Массив из УникальныйИдентификатор - Уникальные идентификаторы заданий
// 
// Возвращаемое значение:
//  Массив Из Произвольный - Получить результаты выполнения
//
Функция РезультатыВыполнения(УникальныеИдентификаторыЗаданий) Экспорт
	
	РезультатыВыполнения = Новый Массив; // Массив Из Структура
	
	Выборка = ВыборкаРезультатыВыполненияЗаданий(УникальныеИдентификаторыЗаданий);
	
	Пока Выборка.Следующий() Цикл
		РезультатВыполнения = Выборка.РезультатВыполнения.Получить(); // Структура
		РезультатыВыполнения.Добавить(РезультатВыполнения);
	КонецЦикла;
		
	Возврат РезультатыВыполнения; 
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Выборки

// Выборка результаты выполнения заданий.
// 
// Параметры:
//  УникальныеИдентификаторыЗаданий - Массив из УникальныйИдентификатор - Уникальные идентификаторы заданий
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка результаты выполнения заданий:
//  * РезультатВыполнения - ХранилищеЗначения
//
Функция ВыборкаРезультатыВыполненияЗаданий(УникальныеИдентификаторыЗаданий)
	
	Запрос = Новый Запрос; 
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РезультатыВыполненияЗаданийCOMСоединений.РезультатВыполнения КАК РезультатВыполнения
		|ИЗ
		|	РегистрСведений.РезультатыВыполненияЗаданийCOMСоединений КАК РезультатыВыполненияЗаданийCOMСоединений
		|ГДЕ
		|	РезультатыВыполненияЗаданийCOMСоединений.УникальныйИдентификаторЗадания В (&КлючиЗаданий)"; 
	Запрос.УстановитьПараметр("КлючиЗаданий", УникальныеИдентификаторыЗаданий); 
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

#КонецОбласти

#Область РаботаСЖурналомРегистрации

// Результат выполнения задания сохранен ВЖР.
// 
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - Уникальный идентификатор
//
Процедура РезультатВыполненияЗаданияСохраненВЖР(УникальныйИдентификатор)
	ИмяСобытия = ИмяКорневогоСобытияЖурналаРегистрации() + "." + СобытияДляЖР().РезультатВыполненияЗаданияСохранен;
	Комментарий = СтрШаблон("Идентификатор = %1", УникальныйИдентификатор);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Примечание, , , Комментарий);
КонецПроцедуры

// Имя корневого события журнала регистрации.
// 
// Возвращаемое значение:
//  Строка - Имя корневого события журнала регистрации
//
Функция ИмяКорневогоСобытияЖурналаРегистрации()
	Возврат "Результаты выполнения заданий COM соединений";
КонецФункции

// События для ЖР.
// 
// Возвращаемое значение:
//  Структура - События для ЖР:
// * РезультатВыполненияЗаданияСохранен - Строка
//
Функция СобытияДляЖР()
	Результат = Новый Структура;
	Результат.Вставить("РезультатВыполненияЗаданияСохранен", "Результат выполнения задания был сохранен");
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
