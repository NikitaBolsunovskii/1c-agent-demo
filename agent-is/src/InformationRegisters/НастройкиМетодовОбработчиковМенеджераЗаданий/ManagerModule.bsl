// @strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// По именам методов.
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - По именам методов:
//   * Ключ - Строка - Имя метода
//   * Значение - Структура: см. НастройкаСтруктурой
//
Функция ПоИменамМетодов() Экспорт
	
	Результат = Новый Соответствие;
	
	Настройки = Настройки();
	Для Каждого Настройка Из Настройки Цикл
		НастройкаСтруктурой = НастройкаСтруктурой(Настройка);
		Результат.Вставить(Настройка.ИмяМетода, НастройкаСтруктурой);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// По умолчанию.
// 
// Возвращаемое значение:
//  Структура - По умолчанию:
// * МаксимальноеКоличествоИсполнителей - Число - Максимальное количество исполнителей
// * МаксимальноеКоличествоПопытокВыполнения - Число - Максимальное количество попыток выполнения
// * ПаузаПередНовойПопыткой - Число - Пауза перед новой попыткой
// * Приоритет - Число - Приоритет
//
Функция ПоУмолчанию() Экспорт
	
	Возврат НастройкаСтруктурой(Неопределено);
	
КонецФункции

// Максимальное количество исполнителей по именам методов.
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Максимальное количество исполнителей по именам методов:
//   * Ключ - Строка - Имя метода
//   * Значение - Число - Максимальное количество исполнителей
//
Функция МаксимальноеКоличествоИсполнителейПоИменамМетодов() Экспорт
	
	Результат = Новый Соответствие;
	
	Выборка = ВыборкаМаксимальноеКоличествоИсполнителейПоИменамМетодов();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ИмяМетода, Выборка.МаксимальноеКоличествоИсполнителей);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Настройки.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Настройки:
//   * ИмяМетода см. РегистрСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.ИмяМетода
//   * МаксимальноеКоличествоИсполнителей см. РегистрСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.МаксимальноеКоличествоИсполнителей
//   * МаксимальноеКоличествоПопытокВыполнения см. РегистрСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.МаксимальноеКоличествоПопытокВыполнения
//   * ПаузаПередНовойПопыткой см. РегистрСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.ПаузаПередНовойПопыткой
//   * Приоритет см. РегистрСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.Приоритет
//
Функция Настройки()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиМетодовОбработчиковМенеджераЗаданий.ИмяМетода КАК ИмяМетода,
		|	НастройкиМетодовОбработчиковМенеджераЗаданий.МаксимальноеКоличествоИсполнителей КАК
		|		МаксимальноеКоличествоИсполнителей,
		|	НастройкиМетодовОбработчиковМенеджераЗаданий.МаксимальноеКоличествоПопытокВыполнения КАК
		|		МаксимальноеКоличествоПопытокВыполнения,
		|	НастройкиМетодовОбработчиковМенеджераЗаданий.ПаузаПередНовойПопыткой КАК ПаузаПередНовойПопыткой,
		|	НастройкиМетодовОбработчиковМенеджераЗаданий.Приоритет КАК Приоритет
		|ИЗ
		|	РегистрСведений.НастройкиМетодовОбработчиковМенеджераЗаданий КАК НастройкиМетодовОбработчиковМенеджераЗаданий";
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Настройка структурой. Если передано в качестве параметра Неопределено, то вернет значения по умолчанию.
// 
// Параметры:
//  Настройка - Неопределено, СтрокаТаблицыЗначений - Настройка:
// * ИмяМетода - Строка - Имя метода
// * МаксимальноеКоличествоИсполнителей - Число - Максимальное количество исполнителей
// * МаксимальноеКоличествоПопытокВыполнения - Число - Максимальное количество попыток выполнения
// * ПаузаПередНовойПопыткой - Число - Пауза перед новой попыткой
// * Приоритет - Число - Приоритет
// 
// Возвращаемое значение:
//  Структура - Настройка структурой:
// * МаксимальноеКоличествоИсполнителей - Число - Максимальное количество исполнителей
// * МаксимальноеКоличествоПопытокВыполнения - Число - Максимальное количество попыток выполнения
// * ПаузаПередНовойПопыткой - Число - Пауза перед новой попыткой
// * Приоритет - Число - Приоритет
//
Функция НастройкаСтруктурой(Настройка)
	
	Результат = Новый Структура;
	Результат.Вставить("МаксимальноеКоличествоИсполнителей", 0);
	Результат.Вставить("МаксимальноеКоличествоПопытокВыполнения", 0);
	Результат.Вставить("ПаузаПередНовойПопыткой", 0);
	Результат.Вставить("Приоритет", 0);
	Если Настройка = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.МаксимальноеКоличествоИсполнителей = Настройка.МаксимальноеКоличествоИсполнителей;
	Результат.МаксимальноеКоличествоПопытокВыполнения = Настройка.МаксимальноеКоличествоПопытокВыполнения;
	Результат.ПаузаПередНовойПопыткой = Настройка.ПаузаПередНовойПопыткой;
	Результат.Приоритет = Настройка.Приоритет;
	
	Возврат Результат;
	
КонецФункции

// Выборка максимальное количество исполнителей по именам методов.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка максимальное количество исполнителей по именам методов:
//  * ИмяМетода - Строка
//  * МаксимальноеКоличествоИсполнителей - Число
//
Функция ВыборкаМаксимальноеКоличествоИсполнителейПоИменамМетодов()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиМетодовОбработчиковМенеджераЗаданий.ИмяМетода КАК ИмяМетода,
	|	НастройкиМетодовОбработчиковМенеджераЗаданий.МаксимальноеКоличествоИсполнителей КАК МаксимальноеКоличествоИсполнителей
	|ИЗ
	|	РегистрСведений.НастройкиМетодовОбработчиковМенеджераЗаданий КАК НастройкиМетодовОбработчиковМенеджераЗаданий
	|ГДЕ
	|	НастройкиМетодовОбработчиковМенеджераЗаданий.МаксимальноеКоличествоИсполнителей > 0";
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

#КонецОбласти

#КонецЕсли
