// @strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Статус фонового COMСоединения.
// 
// Параметры:
//  КаталогБазы - Строка - Каталог базы
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.СтатусыCOMСоединений
//
Функция СтатусФоновогоCOMСоединения(КаталогБазы) Экспорт
	
	Выборка = ВыборкаСтатусПервогоПоКаталогуБазы(КаталогБазы);
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Статус;
	КонецЕсли;
	Возврат Перечисления.СтатусыCOMСоединений.ПустаяСсылка();
	
КонецФункции

// Отметить время последнего использования.
// 
// Параметры:
//  КаталогБазы - Строка - Каталог базы
//  ДатаИВремя - Дата -Дата и время
//
Процедура ОтметитьВремяПоследнегоИспользования(КаталогБазы, ДатаИВремя) Экспорт

	НаборЗаписей = ПрочитанныйНаборЗаписейПоКаталогуБазы(КаталогБазы);

	Если НаборЗаписей.Количество() = 0 Тогда
		ВызватьИсключение "Нет существующих записей о COM соединениях с каталогом базы: " + КаталогБазы;
	КонецЕсли;

	НаборЗаписей[0].ДатаПоследнегоИспользования = ДатаИВремя;
	НаборЗаписей.Записать();
	
	УстановленаОтметкаВремениПоследнегоИспользованияCOMСоединенияВЖР(КаталогБазы, ДатаИВремя);
	
КонецПроцедуры

// Установить статус.
// 
// Параметры:
//  КаталогБазы - Строка - Каталог базы
//  Статус - ПеречислениеСсылка.СтатусыCOMСоединений - Статус
//
Процедура УстановитьСтатус(КаталогБазы, Статус) Экспорт
	
	НаборЗаписей = ПрочитанныйНаборЗаписейПоКаталогуБазы(КаталогБазы);
	
	Если НаборЗаписей.Количество() = 0 Тогда
		ВызватьИсключение "Нет существующих записей о COM соединениях с каталогом базы: " + КаталогБазы;
	КонецЕсли;
	
	ЗаписьCOMСоединения = НаборЗаписей[0];
	ЗаписьCOMСоединения.Статус = Статус;
	НаборЗаписей.Записать();
	
	ОбновленСтатусCOMСоединенияВЖР(ЗаписьCOMСоединения.Статус, КаталогБазы);
	
КонецПроцедуры

// Установить статус подключается.
// 
// Параметры:
//  КаталогБазы - Строка - Каталог базы
// 
// Возвращаемое значение:
//  Структура - результат:
//   * Успех - Булево
//   * ОписаниеОшибки - Строка
//
Функция УстановитьСтатусПодключается(КаталогБазы) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	
	НаборЗаписей = ПрочитанныйНаборЗаписейПоКаталогуБазы(КаталогБазы);
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Результат.ОписаниеОшибки = "Нет существующих записей о COM соединениях с каталогом базы: " + КаталогБазы;
		Возврат Результат;
	КонецЕсли;
	
	ЗаписьCOMСоединения = НаборЗаписей[0];
	Если ЗаписьCOMСоединения.Статус <> Перечисления.СтатусыCOMСоединений.Ожидает Тогда
		Результат.ОписаниеОшибки = "COM-соединение не в статусе ""Ожидает""";
		Возврат Результат;
	КонецЕсли;
	ЗаписьCOMСоединения.Статус = Перечисления.СтатусыCOMСоединений.Подключается;
	НаборЗаписей.Записать();
	Результат.Успех = Истина;
	
	ОбновленСтатусCOMСоединенияВЖР(ЗаписьCOMСоединения.Статус, КаталогБазы);
	
	Возврат Результат;
	
КонецФункции

// УИД Задания совпадает с УИД COM Соединения.
// 
// Параметры:
//  КаталогБазы - Строка - Каталог базы
//  УникальныйИдентификатор  - УникальныйИдентификатор - Уникальный идентификатор
// 
// Возвращаемое значение:
//  Структура - результат проверки:
//   * Успех - Булево
//   * ОписаниеОшибки - Строка
//  
Функция УИДЗаданияСовпадаетСУИДCOMСоединения(КаталогБазы, УникальныйИдентификатор) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	
	НаборЗаписей = ПрочитанныйНаборЗаписейПоКаталогуБазы(КаталогБазы);
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Результат.ОписаниеОшибки = "Нет существующих записей о COM соединениях с каталогом базы: " + КаталогБазы;
		Возврат Результат;
	КонецЕсли;
	
	ЗаписьCOMСоединения = НаборЗаписей[0];
	Если ЗаписьCOMСоединения.УникальныйИдентификаторФоновогоЗадания <> УникальныйИдентификатор Тогда
		Результат.ОписаниеОшибки = "Не совпадает УИД задания в параметрах и в записи COM-соединения";
	Иначе
		Результат.Успех = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Количество фоновых COM соединений.
// 
// Возвращаемое значение:
//  Число - Количество фоновых COM соединений
//
Функция КоличествоФоновыхCOMСоединений() Экспорт
	
	Результат = 0;
	Выборка = ВыборкаКоличествоФоновыхCOMСоединений();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Количество;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Удалить последнее не востребованное COM соединение.
// 
// Возвращаемое значение:
//  Булево - Удалить последнее не востребованное COM соединение
//
Функция УдалитьПоследнееНеВостребованноеCOMСоединение() Экспорт
	
	Результат = Ложь;
	
	УникальныеИдентификаторыНеВыполненныхЗаданийПоКаталогамБаз = 
		РегистрыСведений.ЗаданияCOMСоединений.УникальныеИдентификаторыНеВыполненныхЗаданийПоКаталогамБаз();
	
	Выборка = 
		ВыборкаКаталогиБазИспользовавшихсяCOMСоединенийПоУбываниюДатыИспользования();
	Пока Выборка.Следующий() Цикл
		
		Если УникальныеИдентификаторыНеВыполненныхЗаданийПоКаталогамБаз.Получить(Выборка.КаталогБазы) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УдалитьСоединенияПоКаталогуБазы(Выборка.КаталогБазы);
		Результат = Истина;
		Прервать;
		
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Удалить соединения по каталогу базы.
// 
// Параметры:
//  КаталогБазы - Строка - Каталог базы
//
Процедура УдалитьСоединенияПоКаталогуБазы(КаталогБазы) Экспорт
	
	НаборЗаписей = ПрочитанныйНаборЗаписейПоКаталогуБазы(КаталогБазы);
	
	Если НаборЗаписей.Количество() = 0 Тогда
		ВызватьИсключение "Нет существующих записей о COM соединениях с каталогом базы: " + КаталогБазы;
	КонецЕсли;
	
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();
	
	УдалениеСоединенияВЖР(КаталогБазы);
	
КонецПроцедуры

// Параметры запуска фонового COMСоединения.
// 
// Возвращаемое значение:
//  Структура - Параметры запуска фонового COMСоединения:
// * КаталогБазы - Строка
// * ЛогинБазы - Строка
// * ПарольБазы - Строка
// * УникальныйИдентификатор - УникальныйИдентификатор
//
Функция ПараметрыЗапускаФоновогоCOMСоединения() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("КаталогБазы", "");
	Результат.Вставить("ЛогинБазы", "");
	Результат.Вставить("ПарольБазы", "");
	Результат.Вставить("УникальныйИдентификатор", Новый УникальныйИдентификатор());
	Возврат Результат;
	
КонецФункции

// Запустить фоновое COMСоединение.
// 
// Параметры:
//  ПараметрыЗапуска см. ПараметрыЗапускаФоновогоCOMСоединения
//
Процедура ЗапуститьФоновоеCOMСоединение(ПараметрыЗапуска) Экспорт
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ПараметрыЗапуска);
	МенеджерЗаписи.ДатаДобавления = ТекущаяДатаСеанса();
	МенеджерЗаписи.Статус = Перечисления.СтатусыCOMСоединений.Ожидает; 
	МенеджерЗаписи.УникальныйИдентификаторФоновогоЗадания = 
		РаботаСМенеджеромЗаданий.ДобавитьЗадание(
			ИмяМетодаЗапускаОбработкиЗаданий(),
			ПараметрыЗапуска,
			ПараметрыЗапуска.УникальныйИдентификатор);
	МенеджерЗаписи.Записать();
	
	ЗапускФоновогоCOMСоединенияВЖР(МенеджерЗаписи.УникальныйИдентификаторФоновогоЗадания);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПредопределенныеЛитералы

// Имя метода запуска обработки заданий.
// 
// Возвращаемое значение:
//  Строка - Имя метода запуска обработки заданий
//
Функция ИмяМетодаЗапускаОбработкиЗаданий()
	Возврат "РаботаСЗаданиямиCOMСоединенийСлужебный.ЗапуститьОбработкуЗаданий";
КонецФункции

#КонецОбласти

#Область Выборки

// Выборка количество фоновых COM соединений.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка количество фоновых COM соединений:
//  * Количество - Число
//
Функция ВыборкаКоличествоФоновыхCOMСоединений()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(ФоновыеCOMСоединения.УникальныйИдентификаторФоновогоЗадания) КАК Количество
		|ИЗ
		|	РегистрСведений.COMСоединения КАК ФоновыеCOMСоединения";
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Выборка каталоги баз использовавшихся COM соединений по убыванию даты использования.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка:
//   * КаталогБазы - Строка
//
Функция ВыборкаКаталогиБазИспользовавшихсяCOMСоединенийПоУбываниюДатыИспользования()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФоновыеCOMСоединения.КаталогБазы КАК КаталогБазы
		|ИЗ
		|	РегистрСведений.COMСоединения КАК ФоновыеCOMСоединения
		|ГДЕ
		|	ФоновыеCOMСоединения.ДатаПоследнегоИспользования <> ДАТАВРЕМЯ(1, 1, 1)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФоновыеCOMСоединения.ДатаПоследнегоИспользования УБЫВ";
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Выборка статус первого по каталогу базы.
// 
// Параметры:
//  КаталогБазы - Строка - Каталог базы
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка статус первого по каталогу базы:
//  * Статус - ПеречислениеСсылка.СтатусыCOMСоединений
//
Функция ВыборкаСтатусПервогоПоКаталогуБазы(КаталогБазы)
	
	Запрос = Новый Запрос; 
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаданияСинхронизации.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.COMСоединения КАК ЗаданияСинхронизации
		|ГДЕ
		|	ЗаданияСинхронизации.КаталогБазы = &КаталогБазы"; 
	Запрос.УстановитьПараметр("КаталогБазы", КаталогБазы);
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

#КонецОбласти

#Область Универсальные

// Прочитанный набор записей по каталогу базы.
// 
// Параметры:
//  КаталогБазы - Строка - Каталог базы
// 
// Возвращаемое значение:
//  РегистрСведенийНаборЗаписей.COMСоединения - Прочитанный набор записей по каталогу базы
//
Функция ПрочитанныйНаборЗаписейПоКаталогуБазы(КаталогБазы)
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КаталогБазы.Установить(КаталогБазы);
	НаборЗаписей.Прочитать();
	Возврат НаборЗаписей;
КонецФункции

#КонецОбласти

#Область РаботаСЖурналомРегистрации

// Обновлен статус COMСоединения ВЖР.
// 
// Параметры:
//  НовыйСтатус - ПеречислениеСсылка.СтатусыCOMСоединений - Новый статус
//  КаталогБазы - Строка - Каталог базы
//
Процедура ОбновленСтатусCOMСоединенияВЖР(НовыйСтатус, КаталогБазы)
	ИмяСобытияШаблон = ИмяКорневогоСобытияЖурналаРегистрации() + "." + СобытияДляЖР().ШаблонОбновленСтатусCOMСоединения;
	ИмяСобытия = СтрШаблон(ИмяСобытияШаблон, НовыйСтатус);
	Комментарий = СтрШаблон("Идентификатор = %1", КаталогБазы);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Примечание, , , Комментарий);
КонецПроцедуры

// Установлена отметка времени последнего использования COMСоединения ВЖР.
// 
// Параметры:
//  КаталогБазы - Строка - Каталог базы
//  ДатаИВремя - Дата - Дата и время
//
Процедура УстановленаОтметкаВремениПоследнегоИспользованияCOMСоединенияВЖР(КаталогБазы, ДатаИВремя)
	ИмяСобытияШаблон = ИмяКорневогоСобытияЖурналаРегистрации() + "." 
		+ СобытияДляЖР().ШаблонУстановленаОтметкаВремениПоследнегоИспользованияCOMСоединения;
	ИмяСобытия = СтрШаблон(ИмяСобытияШаблон, Формат(ДатаИВремя, ""));
	Комментарий = СтрШаблон("Идентификатор = %1", КаталогБазы);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Примечание, , , Комментарий);
КонецПроцедуры

// Удаление соединения ВЖР.
// 
// Параметры:
//  КаталогБазы - Строка - Каталог базы
//
Процедура УдалениеСоединенияВЖР(КаталогБазы)
	ИмяСобытия = ИмяКорневогоСобытияЖурналаРегистрации() + "." + СобытияДляЖР().УдаленоCOMСоединение;
	Комментарий = СтрШаблон("Идентификатор = %1", КаталогБазы);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Примечание, , , Комментарий);
КонецПроцедуры

// Запуск фонового COMСоединения ВЖР.
// 
// Параметры:
//  УникальныйИдентификаторФоновогоЗадания - УникальныйИдентификатор - Уникальный идентификатор фонового задания
//
Процедура ЗапускФоновогоCOMСоединенияВЖР(УникальныйИдентификаторФоновогоЗадания)
	ИмяСобытия = ИмяКорневогоСобытияЖурналаРегистрации() + "." + СобытияДляЖР().ЗапускCOMСоединение;
	Комментарий = СтрШаблон("Идентификатор = %1", УникальныйИдентификаторФоновогоЗадания);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Примечание, , , Комментарий);
КонецПроцедуры

// Имя корневого события журнала регистрации.
// 
// Возвращаемое значение:
//  Строка - Имя корневого события журнала регистрации
//
Функция ИмяКорневогоСобытияЖурналаРегистрации()
	Возврат "COM Соединения";
КонецФункции

// События для ЖР.
// 
// Возвращаемое значение:
//  Структура - События для ЖР:
// * УдаленоCOMСоединение - Строка
// * ЗапускCOMСоединение - Строка
// * ШаблонОбновленСтатусCOMСоединения - Строка
// * ШаблонУстановленаОтметкаВремениПоследнегоИспользованияCOMСоединения - Строка
//
Функция СобытияДляЖР()
	Результат = Новый Структура;
	Результат.Вставить("УдаленоCOMСоединение", "COM-Соединение было удалено из регистра.");
	Результат.Вставить("ЗапускCOMСоединение", "Запуск фон. задания COM-Соединения и обработки заданий синхр.");
	Результат.Вставить("ШаблонОбновленСтатусCOMСоединения", "У COM-Соединения был обновлен статус на %1");
	Результат.Вставить("ШаблонУстановленаОтметкаВремениПоследнегоИспользованияCOMСоединения", "Установлена отметка времени посл. исп. COM-Соединения: %1");
	Возврат Результат;
КонецФункции

