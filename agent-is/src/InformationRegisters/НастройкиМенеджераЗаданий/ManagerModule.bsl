// Значения настроек.
// 
// Возвращаемое значение:
//  Структура - Значения настроек:
// * ОграничениеНаКоличествоИсполнителей - Число
// * ГлубинаХраненияИстории - Число
//
Функция ЗначенияНастроек() Экспорт
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Прочитать();
	ОграничениеНаКоличествоИсполнителей = ЗначениеПоУмолчаниюОграниченияНаКоличествоИсполнителей();
	ГлубинаХраненияИстории = ЗначениеПоУмолчаниюГлубиныХраненияИстории();
	Если МенеджерЗаписи.Выбран() Тогда
		ОграничениеНаКоличествоИсполнителей = МенеджерЗаписи.ОграничениеНаКоличествоИсполнителей;
		ГлубинаХраненияИстории = МенеджерЗаписи.ГлубинаХраненияИстории;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ОграничениеНаКоличествоИсполнителей", ОграничениеНаКоличествоИсполнителей);
	Результат.Вставить("ГлубинаХраненияИстории", ГлубинаХраненияИстории);
	Возврат Результат;
	
КонецФункции

// Ограничение на количество исполнителей.
// 
// Возвращаемое значение:
//  Число - Ограничение на количество исполнителей
//
Функция ОграничениеНаКоличествоИсполнителей() Экспорт
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат МенеджерЗаписи.ОграничениеНаКоличествоИсполнителей;
	КонецЕсли;
	Возврат ЗначениеПоУмолчаниюОграниченияНаКоличествоИсполнителей();
	
КонецФункции

// Глубина хранения истории.
// 
// Возвращаемое значение:
//  Число - Глубина хранения истории
//
Функция ГлубинаХраненияИстории() Экспорт
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат МенеджерЗаписи.ГлубинаХраненияИстории;
	КонецЕсли;
	Возврат ЗначениеПоУмолчаниюГлубиныХраненияИстории();
	
КонецФункции

// Предопределенные значения глубины хранения истории.
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Предопределенные значения глубины хранения истории:
// * Бесконечная - Число
// * День - Число
// * Неделя - Число
// * Месяц - Число
//
Функция ПредопределенныеЗначенияГлубиныХраненияИстории() Экспорт
	
	ПредопределенныеЗначенияГлубиныХраненияИстории = Новый Структура();
	ПредопределенныеЗначенияГлубиныХраненияИстории.Вставить("Бесконечная", 0);
	ПредопределенныеЗначенияГлубиныХраненияИстории.Вставить("День", 1);
	ПредопределенныеЗначенияГлубиныХраненияИстории.Вставить("Неделя", 7);
	ПредопределенныеЗначенияГлубиныХраненияИстории.Вставить("Месяц", 30);
	
	Возврат Новый ФиксированнаяСтруктура(ПредопределенныеЗначенияГлубиныХраненияИстории);
	
КонецФункции

// Установить ограничение на количество исполнителей.
// 
// Параметры:
//  Значение - Число - ограничение на количество исполнителей
//
Процедура УстановитьОграничениеНаКоличествоИсполнителей(Значение) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных();
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.НастройкиМенеджераЗаданий");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		МенеджерЗаписи = СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.ГлубинаХраненияИстории = 
				ЗначениеПоУмолчаниюГлубиныХраненияИстории();
		КонецЕсли;
		МенеджерЗаписи.ОграничениеНаКоличествоИсполнителей = Значение;
		МенеджерЗаписи.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"Настройки менеджера заданий", 
			УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки);
		ВызватьИсключение "Не удалось выполнить установку значения настройки. См. Журнал регистрации.";
	КонецПопытки;
	
КонецПроцедуры

// Установить глубину хранения истории.
// 
// Параметры:
//  Значение - Число - глубина хранения истории
//
Процедура УстановитьГлубинуХраненияИстории(Значение) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных();
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.НастройкиМенеджераЗаданий");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		МенеджерЗаписи = СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.ОграничениеНаКоличествоИсполнителей = 
				ЗначениеПоУмолчаниюОграниченияНаКоличествоИсполнителей();
		КонецЕсли;
		МенеджерЗаписи.ГлубинаХраненияИстории = Значение;
		МенеджерЗаписи.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"Настройки менеджера заданий", 
			УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки);
		ВызватьИсключение "Не удалось выполнить установку значения настройки. См. Журнал регистрации.";
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

