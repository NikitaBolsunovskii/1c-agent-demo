// Устанавливает заданию статус "Выполняется", поднимает счетчик количества попыток выполнения на 1,
// возвращает флаг, удалось ли взять задание в работу.
// 
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - УИД задания
//  УникальныйИдентификаторПакета - УникальныйИдентификатор
//  ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений
// 
// Возвращаемое значение:
//  Булево - Задание взято в работу
//
Функция ВзятьЗаданиеВРаботу(УникальныйИдентификатор, УникальныйИдентификаторПакета, ОбработчикЗадания) Экспорт
	
	ЗаданиеВРаботе = Ложь;
	
	// РС "ЗаданияCOMСоединений" блокируется по измерению "УникальныйИдентификатор"
	// После этого происходит попытка сменить статус задания с "Ожидает" на "Выполняется"
	// Блокировка необходима для того, чтобы несколько процессов не могли одновременно взять одно и то же задание в работу
	//
	// Также блокируем РС "ЗаданияCOMСоединений" по обработчику задания, чтобы соблюсти 
	// ограничение по количеству одновременных заданий
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных();
		
		ЭлементБлокировкиУИДы = БлокировкаДанных.Добавить("РегистрСведений.ЗаданияCOMСоединений");
		ЭлементБлокировкиУИДы.УстановитьЗначение("УникальныйИдентификатор", УникальныйИдентификатор);
		ЭлементБлокировкиУИДы.УстановитьЗначение("УникальныйИдентификаторПакета", УникальныйИдентификаторПакета);
		ЭлементБлокировкиУИДы.Режим = РежимБлокировкиДанных.Исключительный;
		
		ЭлементБлокировкиОбработчик = БлокировкаДанных.Добавить("РегистрСведений.ЗаданияCOMСоединений");
		ЭлементБлокировкиОбработчик.УстановитьЗначение("ОбработчикЗадания", ОбработчикЗадания);
		ЭлементБлокировкиОбработчик.Режим = РежимБлокировкиДанных.Исключительный;
		
		БлокировкаДанных.Заблокировать();
		
		Если Не МожноДобавитьЗаданиеПоОбработчику(ОбработчикЗадания) Тогда
			ВызватьИсключение 
				"Не удалось взять задание в работу из-за ограничения по количеству одновременных заданий на обработчик";
		КонецЕсли;
		
		НаборЗаписей = ПрочитанныйНаборЗаписейПоУИДЗаданияИПакета(УникальныйИдентификатор, УникальныйИдентификаторПакета);
		
		Если НаборЗаписей.Количество() = 0 Тогда
			ОписаниеОшибки = 
				ТекстИсключенияОбОтсутствииЗаписейОЗаданияхПоИдентификаторам(
					УникальныйИдентификатор,
					УникальныйИдентификаторПакета);
			ОшибкаВзятияЗаданияВРаботуВЖР(УникальныйИдентификатор, ОписаниеОшибки);
		ИначеЕсли НаборЗаписей.Количество() > 1 Тогда
			ОписаниеОшибки = 
				ТекстИсключенияОНеУникальностиЗаписейОЗаданияхПоИдентификаторам(
					УникальныйИдентификатор,
					УникальныйИдентификаторПакета);
			ОшибкаВзятияЗаданияВРаботуВЖР(УникальныйИдентификатор, ОписаниеОшибки);
		Иначе
			Задание = НаборЗаписей[0];
			Если Задание.Статус <> Перечисления.СтатусыЗаданийCOMСоединений.Ожидает Тогда
				ОписаниеОшибки = 
					ТекстИсключенияЗаписьОЗаданииНеВСтатусеОжидает(
						УникальныйИдентификатор,
						УникальныйИдентификаторПакета);
				ОшибкаВзятияЗаданияВРаботуВЖР(УникальныйИдентификатор, ОписаниеОшибки);
			Иначе
				Задание.Статус = Перечисления.СтатусыЗаданийCOMСоединений.Выполняется;
				Задание.НачалоВыполнения = ТекущаяДатаСеанса();
				Задание.КоличествоПопытокВыполения = Задание.КоличествоПопытокВыполения + 1;
				НаборЗаписей.Записать();
				НачалоВыполненияЗаданияВЖР(УникальныйИдентификатор);
				ЗаданиеВРаботе = Истина;
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОшибкаВзятияЗаданияВРаботуВЖР(УникальныйИдентификатор, ОписаниеОшибки);
		ЗаданиеВРаботе = Ложь;
	КонецПопытки;
	
	Возврат ЗаданиеВРаботе;
КонецФункции

// Устанавливает заданию статус "Выполнено"
// 
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - УИД задания
//  ИдентификаторПакетаЗаданий - УникальныйИдентификатор 
//  ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений
//
Процедура ОтметитьЗавершениеЗадания(УникальныйИдентификатор, ИдентификаторПакетаЗаданий, ОбработчикЗадания) Экспорт
	
	ОписаниеОшибки = "";
	
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных();
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ЗаданияCOMСоединений");
		ЭлементБлокировки.УстановитьЗначение("УникальныйИдентификатор", УникальныйИдентификатор);
		ЭлементБлокировки.УстановитьЗначение("УникальныйИдентификаторПакета", ИдентификаторПакетаЗаданий);
		ЭлементБлокировки.УстановитьЗначение("ОбработчикЗадания", ОбработчикЗадания);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();

		НаборЗаписей = ПрочитанныйНаборЗаписейПоУИДЗаданияИПакета(УникальныйИдентификатор, ИдентификаторПакетаЗаданий);

		Если НаборЗаписей.Количество() = 0 Тогда
			ВызватьИсключение 
				ТекстИсключенияОбОтсутствииЗаписейОЗаданияхПоИдентификаторам(
					УникальныйИдентификатор,
					ИдентификаторПакетаЗаданий);
		КонецЕсли;

		Задание = НаборЗаписей[0];
		Задание.Статус = Перечисления.СтатусыЗаданийCOMСоединений.Выполнено;
		Задание.ЗавершениеВыполнения = ТекущаяДатаСеанса();
		НаборЗаписей.Записать();
		
		ЗавершениеВыполненияЗаданияВЖР(УникальныйИдентификатор);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОшибкаОтметкиЗавершенияЗаданияВЖР(УникальныйИдентификатор, ОписаниеОшибки);
	КонецПопытки;
	
	// Ранее при отсутствии подходящих записей в РС вызывалось исключение
	// Вызов исключения сохранен для корректной работы
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;

КонецПроцедуры

// Таблица уникальные идентификаторы заданий по уникальному идентификатору пакета.
// 
// Параметры:
//  УникальныйИдентификаторПакета - УникальныйИдентификатор - Уникальный идентификатор пакета
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица уникальные идентификаторы заданий по уникальному идентификатору пакета:
//   * УникальныйИдентификатор - УникальныйИдентификатор
//
Функция ТаблицаУникальныеИдентификаторыЗаданийПоУникальномуИдентификаторуПакета(УникальныйИдентификаторПакета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданияCOMСоединений.УникальныйИдентификатор КАК УникальныйИдентификатор
		|ИЗ
		|	РегистрСведений.ЗаданияCOMСоединений КАК ЗаданияCOMСоединений
		|ГДЕ
		|	ЗаданияCOMСоединений.УникальныйИдентификаторПакета = &УникальныйИдентификаторПакета";
	Запрос.УстановитьПараметр("УникальныйИдентификаторПакета", УникальныйИдентификаторПакета);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Добавить одно задание.
// 
// Параметры:
//  ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений - Обработчик задания
//  УникальныйИдентификаторПакета - УникальныйИдентификатор - Уникальный идентификатор пакета
//  ПараметрыЗадания - Структура: см. ПараметрыЗадания
// 
// Возвращаемое значение:
//  см. РезультатДобавленияЗаданий
//  
Функция ДобавитьОдноЗадание(ОбработчикЗадания, УникальныйИдентификаторПакета, ПараметрыЗадания) Экспорт
	
	ПараметрыЗаданий = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыЗадания);
	Возврат ДобавитьПакетЗаданий(ОбработчикЗадания, УникальныйИдентификаторПакета, ПараметрыЗаданий);
	
КонецФункции

// Добавить пакет заданий.
// 
// Параметры:
//  ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений - Обработчик задания
//  УникальныйИдентификаторПакета - УникальныйИдентификатор - Уникальный идентификатор пакета
//  ПараметрыЗаданий - Массив Из Структура: см. ПараметрыЗадания
// 
// Возвращаемое значение:
//  см. РезультатДобавленияЗаданий
//
Функция ДобавитьПакетЗаданий(ОбработчикЗадания, УникальныйИдентификаторПакета, ПараметрыЗаданий) Экспорт
	
	РезультатДобавленияЗаданий = РезультатДобавленияЗаданий();
	
	// Для поддержки блокировки вытащим УИДы заданий в виде таблицы значения.
	УникальныеИдентификаторыЗаданийТаблицей = УникальныеИдентификаторыЗаданийТаблицей(ПараметрыЗаданий);
	
	// РС "ЗаданияCOMСоединений" блокируется по измерениям "УникальныйИдентификатор" и "УникальныйИдентификаторПакета"
	// После этого происходит попытка добавить задания в РС
	// Блокировка по измерению "УникальныйИдентификатор" необходима для того, чтобы несколько процессов не могли одновременно добавить одно и то же задание
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ЗаданияCOMСоединений");
		ЭлементБлокировки.ИсточникДанных = УникальныеИдентификаторыЗаданийТаблицей;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("УникальныйИдентификатор", "УникальныйИдентификатор");
		ЭлементБлокировки.УстановитьЗначение("УникальныйИдентификаторПакета", УникальныйИдентификаторПакета);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		Для Каждого ПараметрыЗадания Из ПараметрыЗаданий Цикл // см. ПараметрыЗадания
			
			ИдентификаторПараметров = Новый УникальныйИдентификатор;
			ИдентификаторПараметровСтрокой = Строка(ИдентификаторПараметров);
			РегистрыСведений.ПараметрыВыполненияЗаданийCOMСоединений.ДобавитьПараметрыВыполнения(ИдентификаторПараметровСтрокой, ПараметрыЗадания);
			
			КлючЗадания = ПараметрыЗадания.КлючЗадания;
			
			ПараметрыЗаданияНаОбработку = ПараметрыЗаданияНаОбработку();
			ПараметрыЗаданияНаОбработку.КаталогБазы = ПараметрыЗадания.КаталогБазы;
			ПараметрыЗаданияНаОбработку.УникальныйИдентификатор = КлючЗадания;
			ПараметрыЗаданияНаОбработку.ОбработчикЗадания = ОбработчикЗадания;
			ПараметрыЗаданияНаОбработку.УникальныйИдентификаторПараметровВыполнения = ИдентификаторПараметровСтрокой;
			ПараметрыЗаданияНаОбработку.ЛогинБазы = ПараметрыЗадания.Логин;
			ПараметрыЗаданияНаОбработку.ПарольБазы = ПараметрыЗадания.Пароль;
			
			ДобавитьЗадание(УникальныйИдентификаторПакета, ПараметрыЗаданияНаОбработку);
			
			РезультатДобавленияЗаданий.ИдентификаторыЗаданий.Добавить(КлючЗадания);
		
		КонецЦикла;
		
		РезультатДобавленияЗаданий.Успех = Истина;
		ДобавленПакетЗаданийВЖР(УникальныйИдентификаторПакета);
		ЗафиксироватьТранзакцию();
	Исключение
		
		ОтменитьТранзакцию();
		РезультатДобавленияЗаданий.Успех = Ложь;
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОшибкаДобавленияПакетаЗаданийВЖР(УникальныйИдентификаторПакета, ОписаниеОшибки);
		
	КонецПопытки;
	
	Возврат РезультатДобавленияЗаданий;
	
КонецФункции

// Статус обработки задания.
// 
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - Уникальный идентификатор
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.СтатусыЗаданийCOMСоединений
//  
Функция СтатусОбработкиЗадания(УникальныйИдентификатор) Экспорт
	
	ПустойСтатус = Перечисления.СтатусыЗаданийCOMСоединений.ПустаяСсылка(); 
	
	Выборка = ВыборкаСтатусОбработкиЗадания(УникальныйИдентификатор);
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Статус;
	КонецЕсли;
	
	Возврат ПустойСтатус;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область Конструкторы

// Параметры задания (приходят на вход через http-сервис).
// 
// Возвращаемое значение:
//  Структура - Параметры задания:
// * КлючЗадания - УникальныйИдентификатор
// * КаталогБазы - Строка
// * Логин - Строка
// * Пароль - Строка
//
Функция ПараметрыЗадания() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("КлючЗадания", ПустойУникальныйИдентификатор());
	Результат.Вставить("КаталогБазы", "");
	Результат.Вставить("Логин", "");
	Результат.Вставить("Пароль", "");
	Возврат Результат;
	
КонецФункции

// Параметры задания на обработку.
// 
// Возвращаемое значение:
//  Структура - Параметры задания на обработку:
// * КаталогБазы - Строка
// * УникальныйИдентификатор - УникальныйИдентификатор
// * ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений
// * УникальныйИдентификаторПараметровВыполнения - Строка
// * ЛогинБазы - Строка
// * ПарольБазы - Строка
//
Функция ПараметрыЗаданияНаОбработку() Экспорт
	
	ПараметрыСтруктура = Новый Структура;
	
	ПараметрыСтруктура.Вставить("КаталогБазы", "");
	ПараметрыСтруктура.Вставить("УникальныйИдентификатор", ПустойУникальныйИдентификатор());
	ПараметрыСтруктура.Вставить("ОбработчикЗадания", Перечисления.ОбработчикиЗаданийCOMСоединений.ПустаяСсылка());
	ПараметрыСтруктура.Вставить("УникальныйИдентификаторПараметровВыполнения", Строка(ПустойУникальныйИдентификатор()));
	ПараметрыСтруктура.Вставить("ЛогинБазы", "");
	ПараметрыСтруктура.Вставить("ПарольБазы", "");
	
	Возврат ПараметрыСтруктура;
	
КонецФункции

// Результат добавления заданий.
// 
// Возвращаемое значение:
//  Структура - Результат добавления заданий:
// * Успех - Булево - результат
// * ИдентификаторыЗаданий см. МассивИзУникальныхИдентификаторов
//
Функция РезультатДобавленияЗаданий() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ИдентификаторыЗаданий", МассивИзУникальныхИдентификаторов());
	Возврат Результат;
	
КонецФункции

#КонецОбласти

// Добавить задание.
// 
// Параметры:
//  УникальныйИдентификаторПакета - УникальныйИдентификатор - Уникальный идентификатор пакета
//  ПараметрыЗаданияНаОбработку см. ПараметрыЗаданияНаОбработку
//
Процедура ДобавитьЗадание(УникальныйИдентификаторПакета, ПараметрыЗаданияНаОбработку) Экспорт
	
	НаборЗаписей = 
		ПрочитанныйНаборЗаписейПоУИДЗаданияИПакета(
			ПараметрыЗаданияНаОбработку.УникальныйИдентификатор,
			УникальныйИдентификаторПакета);
	
	Если НаборЗаписей.Количество() > 0 Тогда
		ПопыткаДобавленияСуществующегоЗаданияВЖР(ПараметрыЗаданияНаОбработку.УникальныйИдентификатор);
		ВызватьИсключение СобытияДляЖР().ПопыткаДобавленияСуществующегоЗадания;
	КонецЕсли;
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ПараметрыЗаданияНаОбработку);
	
	МенеджерЗаписи.УникальныйИдентификаторПакета = УникальныйИдентификаторПакета;
	МенеджерЗаписи.Статус = Перечисления.СтатусыЗаданийCOMСоединений.Ожидает;
	МенеджерЗаписи.ДатаДобавленияВОчередь = ТекущаяДатаСеанса();
	
	ОбработчикТребуетОтправкиРезультата = 
		РаботаСЗаданиямиCOMСоединенийСлужебный.ОбработчикТребуетОтправкиРезультата(
			МенеджерЗаписи.ОбработчикЗадания);
	
	Если ОбработчикТребуетОтправкиРезультата Тогда
		МенеджерЗаписи.СтатусОтправкиРезультата = Перечисления.СтатусыОтправкиРезультатовЗаданийCOMСоединений.Ожидает;
	Иначе
		МенеджерЗаписи.СтатусОтправкиРезультата = Перечисления.СтатусыОтправкиРезультатовЗаданийCOMСоединений.НеТребуется;	
	КонецЕсли;
	
	МенеджерЗаписи.Записать();
	
	ЗаданиеДобавленоВЖР(ПараметрыЗаданияНаОбработку.УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Таблица уникальные идентификаторы не выполненных заданий по каталогам баз.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица уникальные идентификаторы не выполненных заданий по каталогам баз:
//  * КаталогБазы - Строка
//  * УникальныйИдентификатор - УникальныйИдентификатор
//
Функция ТаблицаУникальныеИдентификаторыНеВыполненныхЗаданийПоКаталогамБаз()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданияCOMСоединений.КаталогБазы КАК КаталогБазы,
		|	ЗаданияCOMСоединений.УникальныйИдентификатор КАК УникальныйИдентификатор
		|ИЗ
		|	РегистрСведений.ЗаданияCOMСоединений КАК ЗаданияCOMСоединений
		|ГДЕ
		|	ЗаданияCOMСоединений.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаданийCOMСоединений.Выполнено)";
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Можно добавить задание по обработчику.
// 
// Параметры:
//  ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений - Обработчик задания
// 
// Возвращаемое значение:
//  Булево - Можно добавить задание по обработчику
//
Функция МожноДобавитьЗаданиеПоОбработчику(ОбработчикЗадания)
	
	МаксимальноеКоличествоОдновременныхЗаданийПоОбработчикамЗаданий = 
		РегистрыСведений.НастройкиОбработчиковЗаданийCOMСоединений.МаксимальноеКоличествоОдновременныхЗаданийПоОбработчикамЗаданий();
		
	Если МаксимальноеКоличествоОдновременныхЗаданийПоОбработчикамЗаданий.Получить(ОбработчикЗадания) = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	МаксимальноеКоличествоЗаданийПоОбработчику = 
		МаксимальноеКоличествоОдновременныхЗаданийПоОбработчикамЗаданий[ОбработчикЗадания].МаксимальноеКоличествоОдновременныхЗаданий;
		
	Если МаксимальноеКоличествоЗаданийПоОбработчику = 0 Тогда
		Возврат Истина;	
	КонецЕсли;
	
	Выборка = ВыборкаКоличествоРазличныхУникальныхИдентификаторовВыполняющихсяЗаданийСОбработчиком(ОбработчикЗадания);
	
	Если Выборка.Следующий() Тогда
		КоличествоЗаданийПоОбработчику = Выборка.Количество;
	Иначе
