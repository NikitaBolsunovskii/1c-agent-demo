// Уникальные идентификаторы не выполненных заданий по каталогам баз.
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Уникальные идентификаторы не выполненных заданий по каталогам баз:
//   * Ключ - Строка - Каталог базы
//   * Значение - Массив Из УникальныйИдентификатор - уникальные идентификаторы заданий
//
Функция УникальныеИдентификаторыНеВыполненныхЗаданийПоКаталогамБаз() Экспорт
	
	СведенияЗаданий = ТаблицаУникальныеИдентификаторыНеВыполненныхЗаданийПоКаталогамБаз();
	Результат = Новый Соответствие;
	
	Для Каждого СведенияЗадания Из СведенияЗаданий Цикл
		КаталогБазы = СведенияЗадания.КаталогБазы;
		УникальныйИдентификатор = СведенияЗадания.УникальныйИдентификатор;
		
		УникальныеИдентификаторыЗаданийКаталогаБаз = Результат.Получить(КаталогБазы);
		Если УникальныеИдентификаторыЗаданийКаталогаБаз = Неопределено Тогда
			УникальныеИдентификаторыЗаданийКаталогаБаз = Новый Массив; // Массив Из УникальныйИдентификатор
			Результат.Вставить(КаталогБазы, УникальныеИдентификаторыЗаданийКаталогаБаз);
		КонецЕсли;
		
		УникальныеИдентификаторыЗаданийКаталогаБаз.Добавить(УникальныйИдентификатор);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Вернуть задание в ожидание.
// 
// Параметры:
//  УникальныйИдентификатор см. РегистрСведений.ЗаданияCOMСоединений.УникальныйИдентификатор
//  УникальныйИдентификаторПакета см. РегистрСведений.ЗаданияCOMСоединений.УникальныйИдентификаторПакета
//  ОбработчикЗадания см. РегистрСведений.ЗаданияCOMСоединений.ОбработчикЗадания
//
Процедура ВернутьЗаданиеВОжидание(УникальныйИдентификатор, УникальныйИдентификаторПакета, ОбработчикЗадания) Экспорт
	
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных();
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ЗаданияCOMСоединений");
		ЭлементБлокировки.УстановитьЗначение("УникальныйИдентификатор", УникальныйИдентификатор);
		ЭлементБлокировки.УстановитьЗначение("УникальныйИдентификаторПакета", УникальныйИдентификаторПакета);
		ЭлементБлокировки.УстановитьЗначение("ОбработчикЗадания", ОбработчикЗадания);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();

		НаборЗаписей = ПрочитанныйНаборЗаписейПоУИДЗаданияИПакета(УникальныйИдентификатор, УникальныйИдентификаторПакета);

		Если НаборЗаписей.Количество() = 0 Тогда
			ВызватьИсключение 
				ТекстИсключенияОбОтсутствииЗаписейОЗаданияхПоИдентификаторам(
					УникальныйИдентификатор,
					УникальныйИдентификаторПакета);
		КонецЕсли;

		Задание = НаборЗаписей[0];
		Задание.Статус = Перечисления.СтатусыЗаданийCOMСоединений.Ожидает;
		НаборЗаписей.Записать();

		ЗаданиеВозвращеноВОжиданиеВЖР(УникальныйИдентификатор);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаданиеНеВозвращеноВОжиданиеВЖР(УникальныйИдентификатор, ТекстОшибки);
	КонецПопытки;
	
	// Ранее при отсутствии подходящих записей в РС вызывалось исключение
	// Вызов исключения сохранен для корректной работы
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

// Взять отправку результата пакета в работу.
// 
// Параметры:
//  УникальныеИдентификаторыЗаданий см. ТаблицаУникальныеИдентификаторыЗаданийПоУникальномуИдентификаторуПакета
//  УникальныйИдентификаторПакета - УникальныйИдентификатор - Уникальный идентификатор пакета
//
Процедура ВзятьОтправкуРезультатаПакетаВРаботу(УникальныеИдентификаторыЗаданий, УникальныйИдентификаторПакета) Экспорт

	ТекстОшибки = "";
	НачатьТранзакцию();
	Попытка	
		БлокировкаДанных = Новый БлокировкаДанных();
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ЗаданияCOMСоединений");
		ЭлементБлокировки.ИсточникДанных = УникальныеИдентификаторыЗаданий;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("УникальныйИдентификатор", "УникальныйИдентификатор");
		ЭлементБлокировки.УстановитьЗначение("УникальныйИдентификаторПакета", УникальныйИдентификаторПакета);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		ОбщееКоличествоЗаписей = 0;
		
		Для Каждого СтрокаТаблицы Из УникальныеИдентификаторыЗаданий Цикл
			НаборЗаписей = ПрочитанныйНаборЗаписейПоУИДЗаданияИПакета(
				СтрокаТаблицы.УникальныйИдентификатор, УникальныйИдентификаторПакета);
				
			Если НаборЗаписей.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ОбщееКоличествоЗаписей = ОбщееКоличествоЗаписей + 1;
			
			НаборЗаписей[0].СтатусОтправкиРезультата = 
				Перечисления.СтатусыОтправкиРезультатовЗаданийCOMСоединений.Выполняется;
			НаборЗаписей.Записать();
		КонецЦикла;
	
		Если ОбщееКоличествоЗаписей = 0 Тогда
			ВызватьИсключение 
				ТекстИсключенияОбОтсутствииЗаписейОЗаданияхПоИдентификаторам(
					СтрокаТаблицы.УникальныйИдентификатор,
					УникальныйИдентификаторПакета);
		КонецЕсли;
		
		ОтправкаРезультатаПакетаВзятаВРаботуВЖР(УникальныйИдентификаторПакета);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОтправкаРезультатаПакетаНеВзятаВРаботуВЖР(УникальныйИдентификаторПакета, ТекстОшибки);
	КонецПопытки;
	
	// Ранее при отсутствии подходящих записей в РС вызывалось исключение
	// Вызов исключения сохранен для корректной работы
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

