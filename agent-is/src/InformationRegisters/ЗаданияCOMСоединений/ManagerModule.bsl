// Отметить завершение отправки пакета результата.
// 
// Параметры:
//  УникальныеИдентификаторыЗаданий см. ТаблицаУникальныеИдентификаторыЗаданийПоУникальномуИдентификаторуПакета
//  УникальныйИдентификаторПакета - УникальныйИдентификатор - Уникальный идентификатор пакета
//
Процедура ОтметитьЗавершениеОтправкиПакетаРезультата(УникальныеИдентификаторыЗаданий, УникальныйИдентификаторПакета) Экспорт
	
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных();
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ЗаданияCOMСоединений");
		ЭлементБлокировки.ИсточникДанных = УникальныеИдентификаторыЗаданий;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("УникальныйИдентификатор", "УникальныйИдентификатор");
		ЭлементБлокировки.УстановитьЗначение("УникальныйИдентификаторПакета", УникальныйИдентификаторПакета);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();

