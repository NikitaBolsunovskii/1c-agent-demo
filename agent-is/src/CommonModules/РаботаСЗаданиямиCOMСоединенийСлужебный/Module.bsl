// @strict-types

#Область ПрограммныйИнтерфейс

#Область ОбработчикРегламентногоЗадания

// Менеджер заданий COMСоединений. Обработчик регламентного задания.
//
Процедура МенеджерЗаданийCOMСоединений() Экспорт
	
	ЗначенияНастроек = РегистрыСведений.НастройкиМенеджераЗаданийCOMСоединений.ЗначенияНастроек();
	УдалитьНеиспользуемыеФоновыеCOMСоединения(ЗначенияНастроек);
	ЗапуститьНеобходимыеФоновыеCOMСоединения(ЗначенияНастроек);
	ВернутьВОчередьПотерянныеЗадания();
	ОтправитьГотовыеПакетыДанныхВЕРП();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Запустить обработку заданий.
// 
// Параметры:
//  Параметры см. РегистрыСведений.COMСоединения.ПараметрыЗапускаФоновогоCOMСоединения
// 
// Возвращаемое значение:
//  Булево - Запустить обработку заданий
//
Функция ЗапуститьОбработкуЗаданий(Параметры) Экспорт
	
	Соединение = Неопределено;
	ОписаниеОшибки = "";
	
	// Проверка совпадения УИД фонового задания и УИД задания в записи РС COM-соединения
	// Если УИДы не совпадают, то задание успешно завершается, оставив запись в ЖР
	// Успешное завершение необходимо для того, чтобы лишнее задание не перезапускалось
	// Необходима для того, чтобы избежать ситуации, когда по одной базе активируется 2 задания
	РезультатПроверкиУИД = 
		РегистрыСведений.COMСоединения.УИДЗаданияСовпадаетСУИДCOMСоединения(
			Параметры.КаталогБазы,
			Параметры.УникальныйИдентификатор);
	Если Не РезультатПроверкиУИД.Успех Тогда
		ОписаниеОшибки = РезультатПроверкиУИД.ОписаниеОшибки;
		ОшибкаУстановкиCOMСоединенияВЖР(Параметры.УникальныйИдентификатор, ОписаниеОшибки);
		Возврат Истина;
	КонецЕсли;
	
	// Проверка того, что есть запись в РС COM-соединения в статусе "Ожидает" и с подходящим каталогом базы
	// При наличии подходящей записи переводит её в статус "Подключается"
	// Если такая запись отсутствует или превышено время ожидания блокировки, то задание успешно завершается, оставив
	// запись в ЖР
	// Необходимо для того, чтобы одному COM-соединению отвечало лишь одно фоновое задание 
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.COMСоединения");
		ЭлементБлокировкиДанных.УстановитьЗначение("КаталогБазы", Параметры.КаталогБазы);
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		РезультатУстановкиСтатуса = РегистрыСведений.COMСоединения.УстановитьСтатусПодключается(Параметры.КаталогБазы);
		ЗафиксироватьТранзакцию();
		Если Не РезультатУстановкиСтатуса.Успех Тогда
			ОписаниеОшибки = РезультатУстановкиСтатуса.ОписаниеОшибки;
			ОшибкаУстановкиCOMСоединенияВЖР(Параметры.УникальныйИдентификатор, ОписаниеОшибки);
			Возврат Истина;
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОшибкаУстановкиCOMСоединенияВЖР(Параметры.УникальныйИдентификатор, ОписаниеОшибки);
		Возврат Истина;
	КонецПопытки;
	
	Попытка 
		Соединение = ПолучитьПодключениеКФайловойБД(Параметры.КаталогБазы, Параметры.ЛогинБазы, Параметры.ПарольБазы); 
	Исключение 
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОшибкаУстановкиCOMСоединенияВЖР(Параметры.УникальныйИдентификатор, ОписаниеОшибки);
	КонецПопытки;
	
	Попытка
		
		Запрос = ЗапросЗаданияНаОбработкуПоКаталогуБазы(Параметры.КаталогБазы);
	
		Если Соединение = Неопределено Тогда
			// Запускаем задания с ошибкой COM-Соединения для корректной обработки подобной ситуации
			РегистрыСведений.COMСоединения.УстановитьСтатус(Параметры.КаталогБазы, Перечисления.СтатусыCOMСоединений.Ошибка);
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ОбработатьЗадание(Соединение, Выборка);
			КонецЦикла;
		Иначе
			ТекущийСтатусФоновогоЗадания = Перечисления.СтатусыCOMСоединений.Соединено;
			РегистрыСведений.COMСоединения.УстановитьСтатус(Параметры.КаталогБазы, Перечисления.СтатусыCOMСоединений.Соединено);
			// Запускаем вечный цикл, который будет работать пока не изменится статус Фонового COM-Соединения (или не будет удалена запись из регистра)
			Пока ТекущийСтатусФоновогоЗадания = Перечисления.СтатусыCOMСоединений.Соединено Цикл 	
				
				// Здесь логика такова, что нужно перевыполнять запрос, пока не появятся новые задания. Не убирать.
				//@skip-check query-in-loop
				РезультатЗапроса = Запрос.Выполнить();
				
				Если РезультатЗапроса.Пустой() Тогда
					// Ставим паузу, если нет заданий на обработку, чтобы вечный цикл не нагружал сервер просто так
					РаботаСМенеджеромЗаданийСлужебный.Спать(0.1);
				Иначе
					Выборка = РезультатЗапроса.Выбрать();
					Пока Выборка.Следующий() Цикл 
						ОбработатьЗадание(Соединение, Выборка);	
					КонецЦикла;	
				КонецЕсли;
				ТекущийСтатусФоновогоЗадания = 
					РегистрыСведений.COMСоединения.СтатусФоновогоCOMСоединения(Параметры.КаталогБазы);
			КонецЦикла;
		КонецЕсли;
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОшибкаПриОбработкеЗаданийВЖР(Параметры.УникальныйИдентификатор, ОписаниеОшибки);
	КонецПопытки;
	
	Соединение = Неопределено;
	Возврат Истина;
	
КонецФункции

// Отправка результатов заданий.
// 
// Параметры:
//  Параметры - Структура - параметры вызова процедуры:
//  * ИдентификаторПакета - УникальныйИдентификатор
//  * ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений
//  * РезультатВыполненияПакета см. РезультатВыполненияПакетаОбработчика
//  * УИДыЗаданийТаблица см. РегистрыСведений.ЗаданияCOMСоединений.ТаблицаУникальныеИдентификаторыЗаданийПоУникальномуИдентификаторуПакета
//
Процедура ОтправкаРезультатовЗаданий(Параметры) Экспорт
	
	Попытка
		
		РезультатВыполненияОтправки = 
			РаботаСAPIERP.ОтправитьРезультатПакетаЗаданийCOMСоединений(
				Параметры.ОбработчикЗадания,
				Параметры.РезультатВыполненияПакета);
		
		ОтправленоИОбработаноУспешно = Ложь;
		Если РезультатВыполненияОтправки.Успех Тогда
			Если ТипЗнч(РезультатВыполненияОтправки.Данные) = Тип("Структура") Тогда
				УспешноОбработано = Неопределено;
				РезультатВыполненияОтправки.Данные.Свойство("УспешноОбработано", УспешноОбработано);
				Если УспешноОбработано = Истина Тогда
					ОтправленоИОбработаноУспешно = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ОтправленоИОбработаноУспешно Тогда
			РегистрыСведений.ЗаданияCOMСоединений.ОтметитьЗавершениеОтправкиПакетаРезультата(
				Параметры.УИДыЗаданийТаблица,
				Параметры.ИдентификаторПакета);
		Иначе
			РегистрыСведений.ЗаданияCOMСоединений.ВернутьОтправкуРезультатаПакетаВОжидание(
				Параметры.УИДыЗаданийТаблица,
				Параметры.ИдентификаторПакета);
		КонецЕсли;
		
	Исключение
		
		ИнформацияОбОшибкеПриОтправке = ИнформацияОбОшибке();
		ПодбробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибкеПриОтправке);
		ОшибкаПриОтправкеРезультатовЗаданийВЖР(Параметры.ИдентификаторПакета, ПодбробноеПредставлениеОшибки);
		
		// Само по себе может вызвать исключение, но:
		// т.к. ОтправкаРезультатовЗаданий выполняется через ДлительныеОперации.ВыполнитьПроцедуру, не критично.
		РегистрыСведений.ЗаданияCOMСоединений.ВернутьОтправкуРезультатаПакетаВОжидание(
			Параметры.УИДыЗаданийТаблица,
			Параметры.ИдентификаторПакета);
		
	КонецПопытки;

КонецПроцедуры

// Обработчик требует отправки результата.
// 
// Параметры:
//  ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений - Обработчик задания
// 
// Возвращаемое значение:
//  Булево - Обработчик требует отправки результата
//
Функция ОбработчикТребуетОтправкиРезультата(ОбработчикЗадания) Экспорт
	
	ОбработчикиТребующиеОтправкиРезультата = Новый Массив; // Массив Из ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений
	РаботаСЗаданиямиCOMСоединенийПереопределяемый.ПриОпределенииОбработчиковТребующихОтправкиРезультата(
		ОбработчикиТребующиеОтправкиРезультата);
	
	Возврат ОбработчикиТребующиеОтправкиРезультата.Найти(ОбработчикЗадания) <> Неопределено;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удалить неиспользуемые фоновые COM соединения.
// 
// Параметры:
//  ЗначенияНастроек см. РегистрыСведений.НастройкиМенеджераЗаданийCOMСоединений.ЗначенияНастроек
//
Процедура УдалитьНеиспользуемыеФоновыеCOMСоединения(ЗначенияНастроек)
	
	ДлительностьАктивныхФоновыхЗаданий = ЗначенияНастроек.ДлительностьАктивныхФоновыхЗаданий;
	МаксимальноеКоличествоФоновыхCOMСоединений = ЗначенияНастроек.МаксимальноеКоличествоФоновыхCOMСоединений;
	
	ТекущееКоличествоФоновыхCOMСоединений = РегистрыСведений.COMСоединения.КоличествоФоновыхCOMСоединений();
	Если МаксимальноеКоличествоФоновыхCOMСоединений < ТекущееКоличествоФоновыхCOMСоединений Тогда
		РегистрыСведений.COMСоединения.УдалитьПоследнееНеВостребованноеCOMСоединение();
	КонецЕсли;
	
	Выборка = ВыборкаНеиспользуемыеCOMСоединения();
	Пока Выборка.Следующий() Цикл
		// Удаляем записи, в которых произошли ошибки 
		Если Выборка.Статус = Перечисления.СтатусыCOMСоединений.Ошибка Тогда
			РегистрыСведений.COMСоединения.УдалитьСоединенияПоКаталогуБазы(Выборка.КаталогБазы);
			Продолжить;
		КонецЕсли;
		// Удаляем записи, которые отсутствуют в менеджере заданий или которые по какой-то причине не выполняются
		СостояниеФоновогоЗаданияCOMСоединения = РаботаСМенеджеромЗаданий.СостояниеЗадания(Выборка.УникальныйИдентификаторФоновогоЗадания); 
		Если СостояниеФоновогоЗаданияCOMСоединения = Перечисления.СостоянияЗаданийМенеджераЗаданий.ПустаяСсылка() 
			ИЛИ СостояниеФоновогоЗаданияCOMСоединения = Перечисления.СостоянияЗаданийМенеджераЗаданий.Выполнено
			ИЛИ СостояниеФоновогоЗаданияCOMСоединения = Перечисления.СостоянияЗаданийМенеджераЗаданий.Отменено Тогда
			РегистрыСведений.COMСоединения.УдалитьСоединенияПоКаталогуБазы(Выборка.КаталогБазы);
			Продолжить;
		КонецЕсли;
		// Удаляем записи, которые бездействуют дольше установленного максимума
		РазностьВЧасах = (ТекущаяДатаСеанса() - Выборка.ДатаПоследнегоИспользования) / 3600;
		Если Выборка.ЗаданияВыполнены И ЗначениеЗаполнено(Выборка.ДатаПоследнегоИспользования)
			И РазностьВЧасах > ДлительностьАктивныхФоновыхЗаданий Тогда
			РегистрыСведений.COMСоединения.УдалитьСоединенияПоКаталогуБазы(Выборка.КаталогБазы);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Запустить необходимые фоновые COM соединения.
// 
// Параметры:
//  ЗначенияНастроек см. РегистрыСведений.НастройкиМенеджераЗаданийCOMСоединений.ЗначенияНастроек
//
Процедура ЗапуститьНеобходимыеФоновыеCOMСоединения(ЗначенияНастроек)
	
	МаксимальноеКоличествоФоновыхCOMСоединений = ЗначенияНастроек.МаксимальноеКоличествоФоновыхCOMСоединений;
	ТекущееКоличествоФоновыхCOMСоединений = РегистрыСведений.COMСоединения.КоличествоФоновыхCOMСоединений();
	
	Выборка = ВыборкаНеобходимыеФоновыеCOMСоединения();
	Пока Выборка.Следующий() Цикл
		
		МожноДобавить = МаксимальноеКоличествоФоновыхCOMСоединений - ТекущееКоличествоФоновыхCOMСоединений;
		
		Если МожноДобавить <= 0 Тогда
			Удалено = РегистрыСведений.COMСоединения.УдалитьПоследнееНеВостребованноеCOMСоединение();
			Если Удалено Тогда
				ТекущееКоличествоФоновыхCOMСоединений = РегистрыСведений.COMСоединения.КоличествоФоновыхCOMСоединений();
				МожноДобавить = МаксимальноеКоличествоФоновыхCOMСоединений - ТекущееКоличествоФоновыхCOMСоединений;
			КонецЕсли;
		КонецЕсли;
		
		Если МожноДобавить > 0 Тогда
			ПараметрыЗапуска = РегистрыСведений.COMСоединения.ПараметрыЗапускаФоновогоCOMСоединения();
			РегистрыСведений.COMСоединения.ЗапуститьФоновоеCOMСоединение(ПараметрыЗапуска);
			ТекущееКоличествоФоновыхCOMСоединений = ТекущееКоличествоФоновыхCOMСоединений + 1;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Вернуть в очередь потерянные задания.
// 
// Если после взятия задания в работу произойдет сбой, то задание зависнет. 
// Но, по времени старта фонового задания и времени взятия в работу можно определить, что задание "потерялось".
//
Процедура ВернутьВОчередьПотерянныеЗадания()
	
	Выборка = ВыборкаПотерянныеЗадания();
	Пока Выборка.Следующий() Цикл
		РегистрыСведений.ЗаданияCOMСоединений.ВернутьЗаданиеВОжидание(
			Выборка.УникальныйИдентификатор, 
			Выборка.УникальныйИдентификаторПакета,
			Выборка.ОбработчикЗадания);
	КонецЦикла;
	
КонецПроцедуры

// Отправить готовые пакеты данных в ЕРП.
//
Процедура ОтправитьГотовыеПакетыДанныхВЕРП()
	
	Выборка = ВыборкаГотовыеПакетыДанныхДляЕРП();
	
	Пока Выборка.Следующий() Цикл
		
		УИДыЗаданийТаблица = 
			РегистрыСведений.ЗаданияCOMСоединений.ТаблицаУникальныеИдентификаторыЗаданийПоУникальномуИдентификаторуПакета(
				Выборка.УникальныйИдентификаторПакета);

		РегистрыСведений.ЗаданияCOMСоединений.ВзятьОтправкуРезультатаПакетаВРаботу(
			УИДыЗаданийТаблица, Выборка.УникальныйИдентификаторПакета);

		РезультатыВыполненийЗаданий = Новый Массив; // Массив Из Структура
		ВыборкаДетализаций = Выборка.Выбрать();
		Пока ВыборкаДетализаций.Следующий() Цикл
			РезультатВыполнения = ВыборкаДетализаций.РезультатВыполнения.Получить(); // Структура
			РезультатыВыполненийЗаданий.Добавить(РезультатВыполнения);
		КонецЦикла;
		
		РезультатВыполненияПакета = 
			РезультатВыполненияПакетаОбработчика(
				Выборка.ОбработчикЗадания,
				РезультатыВыполненийЗаданий);
		
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
		ПараметрыВыполнения.ОжидатьЗавершение = 0;
		ПараметрыВыполнения.ЗапуститьВФоне = Истина;
		
		ПараметрыПроцедуры = Новый Структура;
		ПараметрыПроцедуры.Вставить("ИдентификаторПакета", Выборка.УникальныйИдентификаторПакета);
		ПараметрыПроцедуры.Вставить("ОбработчикЗадания", Выборка.ОбработчикЗадания);
		ПараметрыПроцедуры.Вставить("РезультатВыполненияПакета", РезультатВыполненияПакета);
		ПараметрыПроцедуры.Вставить("УИДыЗаданийТаблица", УИДыЗаданийТаблица);
		
		ДлительныеОперации.ВыполнитьПроцедуру(
			ПараметрыВыполнения,
			ИмяМетодаОтправкаРезультатовЗаданий(),
			ПараметрыПроцедуры);
		
	КонецЦикла;
	
КонецПроцедуры

// Результат выполнения пакета обработчика.
// 
// Параметры:
//  ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений - Обработчик задания
//  РезультатыВыполненийЗаданий - Массив Из Структура - Результаты выполнений заданий
// 
// Возвращаемое значение:
//  Структура, Массив Из Структура - Результат выполнения пакета обработчика
//
Функция РезультатВыполненияПакетаОбработчика(ОбработчикЗадания, РезультатыВыполненийЗаданий)
	
	Если РезультатыЗаданийОтправляютсяПакетом(ОбработчикЗадания) Тогда
		Возврат РезультатыВыполненийЗаданий;
	КонецЕсли;
	
	РезультатВыполненияПакета = Неопределено;
	РаботаСЗаданиямиCOMСоединенийПереопределяемый.ПриФормированииРезультатаВыполненияПакета(
		РезультатВыполненияПакета,
		ОбработчикЗадания,
		РезультатыВыполненийЗаданий);
	Если РезультатВыполненияПакета = Неопределено Тогда
		РезультатВыполненияПакета = РезультатыВыполненийЗаданий;
	КонецЕсли;
	
	Возврат РезультатВыполненияПакета;
	
КонецФункции

// Результаты заданий отправляются пакетом.
// 
// Параметры:
//  ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений - Обработчик задания
// 
// Возвращаемое значение:
//  Булево - Результаты заданий отправляются пакетом
//
Функция РезультатыЗаданийОтправляютсяПакетом(ОбработчикЗадания)
	
	ОбработчикиПакетнойОтправки = Новый Массив; // Массив Из ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений
	РаботаСЗаданиямиCOMСоединенийПереопределяемый.ПриОпределенииОбработчиковПакетнойОтправки(ОбработчикиПакетнойОтправки);
	
	Возврат ОбработчикиПакетнойОтправки.Найти(ОбработчикЗадания) <> Неопределено;
	
КонецФункции

// Обработать задание.
// 
// Параметры:
//  Соединение - COMОбъект, Неопределено - Соединение
//  ПараметрыЗадания - ВыборкаИзРезультатаЗапроса - Параметры задания:
//  * УникальныйИдентификатор - УникальныйИдентификатор
//  * УникальныйИдентификаторПакета - УникальныйИдентификатор
//  * Статус - ПеречислениеСсылка.СтатусыЗаданийCOMСоединений
//  * ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений
//  * ПараметрыВыполнения - ХранилищеЗначения
//  * КаталогБазы - Строка
//
Процедура ОбработатьЗадание(Соединение, ПараметрыЗадания)
	
	РегистрыСведений.COMСоединения.ОтметитьВремяПоследнегоИспользования(
		ПараметрыЗадания.КаталогБазы,
		ТекущаяДатаСеанса());
	
	Если Не РегистрыСведений.ЗаданияCOMСоединений.ВзятьЗаданиеВРаботу(
				ПараметрыЗадания.УникальныйИдентификатор, 
				ПараметрыЗадания.УникальныйИдентификаторПакета, 
				ПараметрыЗадания.ОбработчикЗадания) Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения = Неопределено;
	РаботаСЗаданиямиCOMСоединенийПереопределяемый.ПриОбработкеЗадания(
		РезультатВыполнения,
		Соединение,
		ПараметрыЗадания);
	
	РегистрыСведений.РезультатыВыполненияЗаданийCOMСоединений.СохранитьРезультатВыполнения(
		ПараметрыЗадания.УникальныйИдентификатор,
		РезультатВыполнения);
	РегистрыСведений.ЗаданияCOMСоединений.ОтметитьЗавершениеЗадания(
		ПараметрыЗадания.УникальныйИдентификатор,
		ПараметрыЗадания.УникальныйИдентификаторПакета,
		ПараметрыЗадания.ОбработчикЗадания);
	
КонецПроцедуры

#Область Выборки

// Выборка неиспользуемые COM соединения.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка неиспользуемые COM соединения:
//  * УникальныйИдентификаторФоновогоЗадания - УникальныйИдентификатор
//  * ДатаПоследнегоИспользования - Дата
//  * КаталогБазы - Строка
//  * Статус - ПеречислениеСсылка.СтатусыCOMСоединений
//  * ЗаданияВыполнены - Булево
//
Функция ВыборкаНеиспользуемыеCOMСоединения()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаданияCOMСоединений.КаталогБазы КАК КаталогБазы,
		|	МИНИМУМ(ВЫБОР
		|		КОГДА ЗаданияCOMСоединений.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаданийCOMСоединений.Выполнено)
		|		ИЛИ ЗаданияCOMСоединений.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаданийCOMСоединений.Отменено)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ) КАК ЗаданияВыполнены
		|ПОМЕСТИТЬ ВТ_ЗаданияСоединенияВыполнены
		|ИЗ
		|	РегистрСведений.ЗаданияCOMСоединений КАК ЗаданияCOMСоединений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.COMСоединения КАК COMСоединения
		|		ПО ЗаданияCOMСоединений.КаталогБазы = COMСоединения.КаталогБазы
		|СГРУППИРОВАТЬ ПО
		|	ЗаданияCOMСоединений.КаталогБазы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФоновыеCOMСоединения.УникальныйИдентификаторФоновогоЗадания КАК УникальныйИдентификаторФоновогоЗадания,
		|	ФоновыеCOMСоединения.ДатаПоследнегоИспользования КАК ДатаПоследнегоИспользования,
		|	ФоновыеCOMСоединения.КаталогБазы КАК КаталогБазы,
		|	ФоновыеCOMСоединения.Статус КАК Статус,
		|	ВЫБОР
		|		КОГДА ВТ_ЗаданияСоединенияВыполнены.ЗаданияВыполнены ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ВТ_ЗаданияСоединенияВыполнены.ЗаданияВыполнены
		|	КОНЕЦ КАК ЗаданияВыполнены
		|ИЗ
		|	РегистрСведений.COMСоединения КАК ФоновыеCOMСоединения
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаданияСоединенияВыполнены КАК ВТ_ЗаданияСоединенияВыполнены
		|		ПО ФоновыеCOMСоединения.КаталогБазы = ВТ_ЗаданияСоединенияВыполнены.КаталогБазы";
	
	Возврат  Запрос.Выполнить().Выбрать();
	
КонецФункции

// Выборка необходимые фоновые COM соединения.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка необходимые фоновые COM соединения:
//  * КаталогБазы - Строка
//  * ЛогинБазы - Строка
//  * ПарольБазы - Строка
//
Функция ВыборкаНеобходимыеФоновыеCOMСоединения()
	
	ЧастиПакетаЗапросов = Новый Массив; // Массив Из Строка
	ЧастиПакетаЗапросов.Добавить(ТекстЗапросаВременнаяТаблицаНастройкиОбработчиков());
	ЧастиПакетаЗапросов.Добавить(ТекстЗапросаВременнаяТаблицаКоличествоЗапущенныхЗаданийНаОбработчик());
	ЧастиПакетаЗапросов.Добавить(ТекстЗапросаЗаданияКЗапуску());
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиПакетаЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Текст запроса временная таблица настройки обработчиков.
// 
// Возвращаемое значение:
//  Строка - Текст запроса временная таблица настройки обработчиков
//
Функция ТекстЗапросаВременнаяТаблицаНастройкиОбработчиков()
	
	Возврат 
		"ВЫБРАТЬ
		|	НастройкиОбработчиковЗаданийCOMСоединений.ОбработчикЗадания КАК ОбработчикЗадания,
		|	НастройкиОбработчиковЗаданийCOMСоединений.МаксимальноеКоличествоОдновременныхЗаданий КАК
		|		МаксимальноеКоличествоОдновременныхЗаданий,
		|	НастройкиОбработчиковЗаданийCOMСоединений.Приоритет КАК Приоритет
		|ПОМЕСТИТЬ ВТ_НастройкиОбработчиков
		|ИЗ
		|	РегистрСведений.НастройкиОбработчиковЗаданийCOMСоединений КАК НастройкиОбработчиковЗаданийCOMСоединений";
	
КонецФункции

// Текст запроса временная таблица количество запущенных заданий на обработчик.
// 
// Возвращаемое значение:
//  Строка - Текст запроса временная таблица количество запущенных заданий на обработчик
//
Функция ТекстЗапросаВременнаяТаблицаКоличествоЗапущенныхЗаданийНаОбработчик()
	
	Возврат 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаданияCOMСоединений.УникальныйИдентификатор) КАК Количество,
		|	ЗаданияCOMСоединений.ОбработчикЗадания КАК ОбработчикЗадания
		|ПОМЕСТИТЬ ВТ_КоличествоЗапущенныхЗаданийНаОбработчик
		|ИЗ
		|	РегистрСведений.ЗаданияCOMСоединений КАК ЗаданияCOMСоединений
		|ГДЕ
		|	ЗаданияCOMСоединений.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаданийCOMСоединений.Выполняется)
		|СГРУППИРОВАТЬ ПО
		|	ЗаданияCOMСоединений.ОбработчикЗадания";
	
КонецФункции

// Текст запроса задания к запуску.
// 
// Возвращаемое значение:
//  Строка - Текст запроса задания к запуску
//
Функция ТекстЗапросаЗаданияКЗапуску()
	
	Возврат 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаданияСинхронизации.КаталогБазы КАК КаталогБазы,
		|	ЗаданияСинхронизации.ЛогинБазы КАК ЛогинБазы,
		|	ЗаданияСинхронизации.ПарольБазы КАК ПарольБазы
		|ИЗ
		|	РегистрСведений.ЗаданияCOMСоединений КАК ЗаданияСинхронизации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.COMСоединения КАК ФоновыеCOMСоединения
		|		ПО ФоновыеCOMСоединения.КаталогБазы = ЗаданияСинхронизации.КаталогБазы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НастройкиОбработчиков КАК ВТ_НастройкиОбработчиков
		|		ПО ЗаданияСинхронизации.ОбработчикЗадания = ВТ_НастройкиОбработчиков.ОбработчикЗадания
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоЗапущенныхЗаданийНаОбработчик КАК ВТ_КоличествоЗапущенныхЗаданийНаОбработчик
		|		ПО ЗаданияСинхронизации.ОбработчикЗадания = ВТ_КоличествоЗапущенныхЗаданийНаОбработчик.ОбработчикЗадания
		|ГДЕ
		|	ЗаданияСинхронизации.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаданийCOMСоединений.Ожидает)
		|	И ФоновыеCOMСоединения.КаталогБазы ЕСТЬ NULL
		|	И (ЕСТЬNULL(ВТ_НастройкиОбработчиков.МаксимальноеКоличествоОдновременныхЗаданий, 0) = 0
		|	ИЛИ ВТ_КоличествоЗапущенныхЗаданийНаОбработчик.Количество ЕСТЬ NULL
		|	ИЛИ
		|		ВТ_НастройкиОбработчиков.МаксимальноеКоличествоОдновременныхЗаданий > ВТ_КоличествоЗапущенныхЗаданийНаОбработчик.Количество)";
	
КонецФункции

// Выборка потерянные задания.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка потерянные задания:
//  * УникальныйИдентификатор - УникальныйИдентификатор
//  * УникальныйИдентификаторПакета - УникальныйИдентификатор
//  * ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений
//
Функция ВыборкаПотерянныеЗадания()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаданияСинхронизации.УникальныйИдентификатор КАК УникальныйИдентификатор,
		|	ЗаданияСинхронизации.УникальныйИдентификаторПакета КАК УникальныйИдентификаторПакета,
		|	ЗаданияСинхронизации.ОбработчикЗадания КАК ОбработчикЗадания
		|ИЗ
		|	РегистрСведений.ЗаданияCOMСоединений КАК ЗаданияСинхронизации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.COMСоединения КАК ФоновыеCOMСоединения
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗаданияМенеджераЗаданий КАК ЗаданияМенеджераЗаданий
		|			ПО ЗаданияМенеджераЗаданий.Ключ = ФоновыеCOMСоединения.УникальныйИдентификаторФоновогоЗадания
		|		ПО ЗаданияСинхронизации.КаталогБазы = ФоновыеCOMСоединения.КаталогБазы
		|ГДЕ
		|	ЗаданияСинхронизации.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаданийCOMСоединений.Выполняется)
		|	И ЗаданияСинхронизации.НачалоВыполнения > ДАТАВРЕМЯ(1, 1, 1)
		|	И (ФоновыеCOMСоединения.УникальныйИдентификаторФоновогоЗадания ЕСТЬ NULL
		|	ИЛИ НЕ ФоновыеCOMСоединения.УникальныйИдентификаторФоновогоЗадания ЕСТЬ NULL
		|	И ЗаданияМенеджераЗаданий.НачалоВыполнения > ЗаданияСинхронизации.НачалоВыполнения)";
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Выборка готовые пакеты данных для ЕРП.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка готовые пакеты данных для ЕРП:
//  * УникальныйИдентификаторПакета - УникальныйИдентификатор
//  * РезультатВыполнения - ХранилищеЗначения
//  * ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений
//
Функция ВыборкаГотовыеПакетыДанныхДляЕРП()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданияCOMСоединений.УникальныйИдентификаторПакета КАК УникальныйИдентификаторПакета,
		|	СУММА(1) КАК ОбщееКоличествоПакетов,
		|	СУММА(ВЫБОР
		|		КОГДА ЗаданияCOMСоединений.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаданийCOMСоединений.Выполнено)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ) КАК КоличествоГотовыхПакетов
		|ПОМЕСТИТЬ ВТ_ПакетыКОтправке
		|ИЗ
		|	РегистрСведений.ЗаданияCOMСоединений КАК ЗаданияCOMСоединений
		|ГДЕ
		|	ЗаданияCOMСоединений.СтатусОтправкиРезультата = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправкиРезультатовЗаданийCOMСоединений.Ожидает)
		|СГРУППИРОВАТЬ ПО
		|	ЗаданияCOMСоединений.УникальныйИдентификаторПакета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПакетыКОтправке.УникальныйИдентификаторПакета КАК УникальныйИдентификаторПакета,
		|	РезультатыВыполненияЗаданийCOMСоединений.РезультатВыполнения КАК РезультатВыполнения,
		|	ЗаданияСинхронизации.ОбработчикЗадания КАК ОбработчикЗадания
		|ИЗ
		|	ВТ_ПакетыКОтправке КАК ВТ_ПакетыКОтправке
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗаданияCOMСоединений КАК ЗаданияСинхронизации
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РезультатыВыполненияЗаданийCOMСоединений КАК
		|				РезультатыВыполненияЗаданийCOMСоединений
		|			ПО РезультатыВыполненияЗаданийCOMСоединений.УникальныйИдентификаторЗадания = ЗаданияСинхронизации.УникальныйИдентификатор
		|		ПО ЗаданияСинхронизации.УникальныйИдентификаторПакета = ВТ_ПакетыКОтправке.УникальныйИдентификаторПакета
		|ГДЕ
		|	ВТ_ПакетыКОтправке.ОбщееКоличествоПакетов = ВТ_ПакетыКОтправке.КоличествоГотовыхПакетов
		|ИТОГИ
		|	МАКСИМУМ(ОбработчикЗадания) КАК ОбработчикЗадания
		|ПО
		|	УникальныйИдентификаторПакета";
		
	Возврат Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
КонецФункции

// Запрос задания на обработку по каталогу базы.
// 
// Параметры:
//  КаталогБазы - Строка - Каталог базы
// 
// Возвращаемое значение:
//  Запрос - Запрос задания на обработку по каталогу базы
//
Функция ЗапросЗаданияНаОбработкуПоКаталогуБазы(КаталогБазы)
	
	ЧастиПакетаЗапросов = Новый Массив; // Массив Из Строка
	ЧастиПакетаЗапросов.Добавить(ТекстЗапросаВременнаяТаблицаНастройкиОбработчиков());
	ЧастиПакетаЗапросов.Добавить(ТекстЗапросаВременнаяТаблицаКоличествоЗапущенныхЗаданийНаОбработчик());
	ЧастиПакетаЗапросов.Добавить(ТекстЗапросаЗаданияНаОбработкуПоКаталогуБазы());
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиПакетаЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	Запрос.УстановитьПараметр("КаталогБазы", КаталогБазы);
	Возврат Запрос;
	
КонецФункции

// Текст запроса задания на обработку по каталогу базы.
// 
// Возвращаемое значение:
//  Строка - Текст запроса задания на обработку по каталогу базы
//
Функция ТекстЗапросаЗаданияНаОбработкуПоКаталогуБазы()
	
	Возврат 
		"ВЫБРАТЬ
		|	ЗаданияСинхронизации.УникальныйИдентификатор КАК УникальныйИдентификатор,
		|	ЗаданияСинхронизации.УникальныйИдентификаторПакета КАК УникальныйИдентификаторПакета,
		|	ЗаданияСинхронизации.Статус КАК Статус,
		|	ЗаданияСинхронизации.ОбработчикЗадания КАК ОбработчикЗадания,
		|	ПараметрыВыполненияЗаданийCOMСоединений.ПараметрыВыполнения КАК ПараметрыВыполнения,
		|	ЗаданияСинхронизации.КаталогБазы КАК КаталогБазы
		|ИЗ
		|	РегистрСведений.ЗаданияCOMСоединений КАК ЗаданияСинхронизации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыВыполненияЗаданийCOMСоединений КАК
		|			ПараметрыВыполненияЗаданийCOMСоединений
		|		ПО ПараметрыВыполненияЗаданийCOMСоединений.УникальныйИдентификатор = ЗаданияСинхронизации.УникальныйИдентификаторПараметровВыполнения
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НастройкиОбработчиков КАК ВТ_НастройкиОбработчиков
		|		ПО ЗаданияСинхронизации.ОбработчикЗадания = ВТ_НастройкиОбработчиков.ОбработчикЗадания
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоЗапущенныхЗаданийНаОбработчик КАК ВТ_КоличествоЗапущенныхЗаданийНаОбработчик
		|		ПО ЗаданияСинхронизации.ОбработчикЗадания = ВТ_КоличествоЗапущенныхЗаданийНаОбработчик.ОбработчикЗадания
		|ГДЕ
		|	ЗаданияСинхронизации.КаталогБазы = &КаталогБазы
		|	И ЗаданияСинхронизации.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаданийCOMСоединений.Ожидает)
		|	И (ЕСТЬNULL(ВТ_НастройкиОбработчиков.МаксимальноеКоличествоОдновременныхЗаданий, 0) = 0
		|	ИЛИ ВТ_КоличествоЗапущенныхЗаданийНаОбработчик.Количество ЕСТЬ NULL
		|	ИЛИ
		|		ВТ_НастройкиОбработчиков.МаксимальноеКоличествоОдновременныхЗаданий > ВТ_КоличествоЗапущенныхЗаданийНаОбработчик.Количество)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЕСТЬNULL(ВТ_НастройкиОбработчиков.Приоритет, 0) УБЫВ,
		|	ЗаданияСинхронизации.ДатаДобавленияВОчередь";
	
КонецФункции

