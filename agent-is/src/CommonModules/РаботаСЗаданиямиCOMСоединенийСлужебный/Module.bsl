// Получить подключение к файловой БД.
// 
// Параметры:
//  КаталогБазы - Строка - Каталог базы
//  Логин - Строка - Логин
//  Пароль - Строка - Пароль
// 
// Возвращаемое значение:
//  COMОбъект - подключение к файловой БД
//
Функция ПолучитьПодключениеКФайловойБД(КаталогБазы, Логин, Пароль)
	
	Параметры 		= СтрШаблон("File=""%1"";Usr=""%2"";Pwd=""%3"";", КаталогБазы, Логин, Пароль);
	V83COMConnector	= Новый COMОбъект("V83.COMConnector");
	Возврат V83COMConnector.Connect(Параметры);
	
КонецФункции

