// @strict-types

#Область ПрограммныйИнтерфейс

// Подготовить соединение HTTP.
// 
// Параметры:
//  АдресСервера - Строка - Адрес сервера
//  ПортСервера - Число, Неопределено - Порт сервера
//  ТаймайтСоединения - Число - Таймаут соединения
//  Прокси - Неопределено, ИнтернетПрокси - Прокси
//  ЗащищенноеСоединение - Неопределено, ЗащищенноеСоединениеOpenSSL - Защищенное соединение
// 
// Возвращаемое значение:
//  HTTPСоединение - Подготовить соединение HTTP
//
Функция ПодготовитьСоединениеHTTP(АдресСервера, ПортСервера, ТаймайтСоединения, 
		Прокси = Неопределено, ЗащищенноеСоединение = Неопределено) Экспорт
	
	Результат = Новый HTTPСоединение(
		АдресСервера,
		ПортСервера, 
		Неопределено, 
		Неопределено, 
		Прокси,
		ТаймайтСоединения, 
		ЗащищенноеСоединение);
	Возврат Результат;
	
КонецФункции

// Подготовить запрос HTTP.
// 
// Параметры:
//  АдресРесурса - Строка - Адрес ресурса
//  Заголовки - Соответствие из КлючИЗначение - Заголовки
//  ТелоЗапроса - Строка - Тело запроса строкой
// 
// Возвращаемое значение:
//  HTTPЗапрос - Подготовленный запрос HTTP
//
Функция ПодготовитьЗапросHTTP(АдресРесурса, Заголовки, ТелоЗапроса) Экспорт
	
	Результат = Новый HTTPЗапрос(АдресРесурса, Заголовки);
	Если ТипЗнч(ТелоЗапроса) = Тип("Строка") Тогда
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			Результат.УстановитьТелоИзСтроки(ТелоЗапроса);
		КонецЕсли;
	Иначе
		ВызватьИсключение "Тело запроса передано не в виде строки";
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Выполнить запрос HTTP.
// 
// Параметры:
//  ТипЗапросаHTTP - Строка - GET, POST
//  СоединениеHTTP - HTTPСоединение - Соединение HTTP
//  ЗапросHTTP - HTTPЗапрос - Запрос HTTP
//  ЛогироватьHTTPЗапросыИОтветы - Булево
//  ДесериализовыватьВСоответствие - Булево
//  НеДесериализовывать - Булево
// 
// Возвращаемое значение:
//  Структура - результат запроса HTTP:
// * Выполнен - Булево
// * ОшибкаВыполнения - Строка
// * КодСостояния - Число
// * ТелоОтвета - Строка, Неопределено -
// * ТелоОтветаДесериализовано - Булево
// * ДесериализованныйJSONОтвета - Структура, Неопределено, Соответствие Из КлючИЗначение -
//
Функция ВыполнитьЗапросHTTP(ТипЗапросаHTTP, СоединениеHTTP, ЗапросHTTP, ЛогироватьHTTPЗапросыИОтветы, 
		ДесериализовыватьВСоответствие, НеДесериализовывать) Экспорт
	
	ЛогироватьЗапрос(ТипЗапросаHTTP, СоединениеHTTP, ЗапросHTTP, ЛогироватьHTTPЗапросыИОтветы);
	
	ОтветHTTP = Неопределено;
	ОшибкаВыполнения = "";
	Попытка
		ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод(ТипЗапросаHTTP, ЗапросHTTP);
		ЛогироватьОтвет(ОтветHTTP, ЛогироватьHTTPЗапросыИОтветы);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОшибкаВыполнения = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЗаписьЖурналаРегистрации(
			СтрШаблон("%1.%2", "РаботаСHTTP", "Выполнение метода HTTP"),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОшибкаВыполнения);
	КонецПопытки;
	
	Результат = РезультатЗапросаHTTP();
	Результат.Выполнен = ОтветHTTP <> Неопределено;
	Результат.ОшибкаВыполнения = ОшибкаВыполнения;
	
	Если ОтветHTTP = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.КодСостояния = ОтветHTTP.КодСостояния;
	Результат.ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
	
	Если ЗначениеЗаполнено(Результат.ТелоОтвета) И КодСостоянияУспешный(Результат.КодСостояния) Тогда
		Если НеДесериализовывать Тогда
			Результат.ТелоОтветаДесериализовано = Ложь;
			Результат.ДесериализованныйJSONОтвета = Неопределено;
		Иначе
			Попытка
				Если ДесериализовыватьВСоответствие Тогда
					Результат.ДесериализованныйJSONОтвета = РаботаСJSON.ДесериализоватьJSONВСоответствие(Результат.ТелоОтвета);
				Иначе
					Результат.ДесериализованныйJSONОтвета = РаботаСJSON.ДесериализоватьJSONВСтруктуру(Результат.ТелоОтвета);
				КонецЕсли;
				Результат.ТелоОтветаДесериализовано = Истина;
			Исключение
				Результат.ДесериализованныйJSONОтвета = Неопределено;
				Результат.ТелоОтветаДесериализовано = Ложь;
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ОшибкаВыполнения = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
				ЗаписьЖурналаРегистрации(
					СтрШаблон("%1.%2", "РаботаСHTTP", "Десериализация тела ответа HTTP"),
					УровеньЖурналаРегистрации.Ошибка, , ,
					ОшибкаВыполнения);
				Результат.ОшибкаВыполнения = ОшибкаВыполнения;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Стандартные заголовки запроса HTTP.
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Стандартные заголовки запроса HTTP
//
Функция СтандартныеЗаголовкиЗапросаHTTP() Экспорт
	
	Результат = Новый Соответствие;
	Результат.Вставить("User-Agent", "1C Enterprise 8.3");
	Результат.Вставить("Accept", "*/*");
	Результат.Вставить("Content-Type", "application/json");
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Код состояния успешный.
// 
// Параметры:
//  Код - Число - Код
// 
// Возвращаемое значение:
//  Булево - Код состояния успешный
//
Функция КодСостоянияУспешный(Код) Экспорт
	
	КодыУспешные = Новый Массив; // Массив Из Число
	КодыУспешные.Добавить(200);
	КодыУспешные.Добавить(201);
	КодыУспешные.Добавить(202);
	КодыУспешные.Добавить(204);
	
	Возврат КодыУспешные.Найти(Код) <> Неопределено;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Результат запроса HTTP.
// 
// Возвращаемое значение:
//  Структура - Результат запроса HTTP:
// * Выполнен - Булево
// * ОшибкаВыполнения - Строка
// * КодСостояния - Число
// * ТелоОтвета - Неопределено
// * ТелоОтветаДесериализовано - Булево
// * ДесериализованныйJSONОтвета - Неопределено
//
Функция РезультатЗапросаHTTP()
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнен", Ложь);
	Результат.Вставить("ОшибкаВыполнения", "");
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("ТелоОтвета", Неопределено);
	Результат.Вставить("ТелоОтветаДесериализовано", Ложь);
	Результат.Вставить("ДесериализованныйJSONОтвета", Неопределено);
	Возврат Результат;
	
КонецФункции

Процедура ЛогироватьОтвет(ОтветHTTP, ЛогироватьHTTPЗапросыИОтветы)
	
	Если Не ЛогироватьHTTPЗапросыИОтветы Тогда
		Возврат;
	КонецЕсли;
	
	КодСостоянияСтрокой = Формат(ОтветHTTP.КодСостояния, "ЧГ=;");
	ТелоОтветаСтрокой = ОтветHTTP.ПолучитьТелоКакСтроку();
	КомментарийЖурналаРегистрации = 
		СтрШаблон(
			"status code: %1
			|---------------------------------------------------
			|body:
			|%2",
			КодСостоянияСтрокой,
			ТелоОтветаСтрокой);
	ИмяСобытияЖурналаРегистрации = СтрШаблон("%1.%2", "РаботаСHTTP", "DEBUG-INFO.http-response");
	ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурналаРегистрации,
			УровеньЖурналаРегистрации.Информация, , ,
			КомментарийЖурналаРегистрации);
	
КонецПроцедуры

Процедура ЛогироватьЗапрос(ТипЗапросаHTTP, СоединениеHTTP, ЗапросHTTP, ЛогироватьHTTPЗапросыИОтветы)
	
	Если Не ЛогироватьHTTPЗапросыИОтветы Тогда
		Возврат;
	КонецЕсли;
	
	АдресЗапросаСПараметрами = 
		?(СоединениеHTTP.ЗащищенноеСоединение <> Неопределено, "https", "http") + "://" 
					+ СоединениеHTTP.Сервер + ":" + Формат(СоединениеHTTP.Порт, "ЧГ=;") + ЗапросHTTP.АдресРесурса;
	ТелоЗапросаСтрокой = ЗапросHTTP.ПолучитьТелоКакСтроку();
	ЗаголовкиЗапросаСтрокой = ЗаголовкиЗапросаВСтроку(ЗапросHTTP.Заголовки);
	
	КомментарийЖурналаРегистрации = 
		СтрШаблон(
			"request: %1 %2
			|---------------------------------------------------
			|body:
			|%3
			|---------------------------------------------------
			|headers:
			|%4",
			ТипЗапросаHTTP,
			АдресЗапросаСПараметрами,
			ТелоЗапросаСтрокой,
			ЗаголовкиЗапросаСтрокой);
	ИмяСобытияЖурналаРегистрации = СтрШаблон("%1.%2", "РаботаСHTTP", "DEBUG-INFO.http-request");
	
	ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурналаРегистрации,
			УровеньЖурналаРегистрации.Информация, , ,
			КомментарийЖурналаРегистрации);
	
КонецПроцедуры

// Заголовки запроса в строку.
// 
// Параметры:
//  Заголовки - Соответствие Из КлючИЗначение - Заголовки
// 
// Возвращаемое значение:
//  Строка
//
Функция ЗаголовкиЗапросаВСтроку(Заголовки)
	
	Результат = Новый Массив; // Массив Из Строка
	Для Каждого Заголовок Из Заголовки Цикл
		Ключ = Заголовок.Ключ; // Строка
		Значение = Заголовок.Значение; // Строка
		Если СтрНайти(НРег(Ключ), "token") <> 0 Тогда
			Значение = МаскироватьСтроку(Значение, 5, 5);
		КонецЕсли;
		ЗаголовокСтрокой = СтрШаблон("%1=%2",
			Ключ,
			Значение);
		Результат.Добавить(ЗаголовокСтрокой);
	КонецЦикла;
	Возврат СтрСоединить(Результат, Символы.ПС);
	
КонецФункции

// Маскирует строку, заменяя центральную часть на указанный символ.
//
// Параметры:
//  ИсходнаяСтрока - Строка - текст, который нужно замаскировать;
//  ВидимоСначала  - Число  - количество символов, оставляемых открытыми в начале;
//  ВидимоСКонца   - Число  - количество символов, оставляемых открытыми в конце;
//  СимволМаски    - Строка - символ, которым заменяются скрытые знаки (по умолчанию "*").
//
// Возвращаемое значение:
//  Строка - замаскированный текст.
//
Функция МаскироватьСтроку(Знач ИсходнаяСтрока, Знач ВидимоСначала = 0, Знач ВидимоСКонца = 0, Знач СимволМаски = "*")
	
	ИсходнаяСтрока = СокрЛП(ИсходнаяСтрока);
	ДлинаСтроки = СтрДлина(ИсходнаяСтрока);
	
	// Если строка пустая или ее длина меньше открытых зон, возвращаем заглушку
	Если ДлинаСтроки = 0 Или (ВидимоСначала + ВидимоСКонца) >= ДлинаСтроки Тогда
		Возврат "*****";
	КонецЕсли;
	
	// Выделяем открытые части
	НачалоСтроки = Лев(ИсходнаяСтрока, ВидимоСначала);
	КонецСтроки  = Прав(ИсходнаяСтрока, ВидимоСКонца);
	
	// Вычисляем длину маскируемой части
	ДлинаМаски = ДлинаСтроки - ВидимоСначала - ВидимоСКонца;
	
	// Формируем строку из символов маски
	СтрокаМаски = "";
	Для Счетчик = 1 По ДлинаМаски Цикл
		СтрокаМаски = СтрокаМаски + СимволМаски;
	КонецЦикла;
	
	Возврат НачалоСтроки + СтрокаМаски + КонецСтроки;
	
КонецФункции

#КонецОбласти
