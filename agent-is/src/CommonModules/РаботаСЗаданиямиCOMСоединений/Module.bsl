// Обработчик задания по имени обработчика.
// 
// Параметры:
//  ИмяОбработчика - Строка - Имя обработчика
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений -  Обработчик задания
//
Функция ОбработчикЗаданияПоИмениОбработчика(ИмяОбработчика) Экспорт
	
	ПустойОбработчикЗадания = Перечисления.ОбработчикиЗаданийCOMСоединений.ПустаяСсылка();
	
	ОбработчикиЗаданийПоИменамОбработчиков = Новый Соответствие;
	РаботаСЗаданиямиCOMСоединенийПереопределяемый.ПриОпределенииОбработчиковЗаданийПоИменамОбработчиков(
		ОбработчикиЗаданийПоИменамОбработчиков);
		
	ОбработчикЗадания = ОбработчикиЗаданийПоИменамОбработчиков.Получить(ИмяОбработчика);
	Если Не ЗначениеЗаполнено(ОбработчикЗадания) Тогда
		ОбработчикЗадания = ПустойОбработчикЗадания;
	КонецЕсли;
	
	Возврат ОбработчикЗадания;
	
КонецФункции

// Добавить задание.
// 
// Параметры:
//  ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений - Обработчик задания
//  ПараметрыЗаданий - Массив Из Структура: см. РегистрыСведений.ЗаданияCOMСоединений.ПараметрыЗадания
// 
// Возвращаемое значение:
//  см. РегистрыСведений.ЗаданияCOMСоединений.ДобавитьПакетЗаданий
//
Функция ДобавитьЗадания(ОбработчикЗадания, ПараметрыЗаданий) Экспорт
	
	// Чтобы можно было отследить в каком пакете было прислано то или иное задание
	УникальныйИдентификаторПакета = Новый УникальныйИдентификатор();
	
	Результат = РегистрыСведений.ЗаданияCOMСоединений.ДобавитьПакетЗаданий(
		ОбработчикЗадания,
		УникальныйИдентификаторПакета,
		ПараметрыЗаданий);
		
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти
