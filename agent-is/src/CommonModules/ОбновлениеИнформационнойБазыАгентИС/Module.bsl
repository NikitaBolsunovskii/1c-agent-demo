// Параметры:
//  Описание - Структура: см. ОбновлениеИнформационнойБазыБСП.ПриДобавленииПодсистемы.Описание
//
Процедура ПриДобавленииПодсистемы(Описание) Экспорт
    
    Описание.Имя = "АгентИС";
    Описание.Версия = "1.0.0.0";
    
    // Требуется библиотека стандартных подсистем.
    ТребуемыеПодсистемы = Описание.ТребуемыеПодсистемы; // Массив Из Строка
    ТребуемыеПодсистемы.Добавить("СтандартныеПодсистемы");
    
КонецПроцедуры

