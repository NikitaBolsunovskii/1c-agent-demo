// @strict-types

#Область ПрограммныйИнтерфейс

// Добавить задание.
// 
// Параметры:
//  ИмяМетода - Строка - Имя метода
//  Параметры - Структура - Параметры
//  КлючЗадания - Неопределено, Строка - Ключ задания
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - ключ задания
//  
Функция ДобавитьЗадание(ИмяМетода, Параметры, КлючЗадания = Неопределено) Экспорт
	
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		ТекстИсключения = "Параметры задания должны иметь тип <Структура>";
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Задание = 
		РегистрыСведений.ЗаданияМенеджераЗаданий.НовыйМенеджерЗаписи(
			ИмяМетода,
			Параметры,
			КлючЗадания);
	Задание.Состояние = Перечисления.СостоянияЗаданийМенеджераЗаданий.Ожидает;
	Задание.Записать();
	Возврат Задание.Ключ;
	
КонецФункции

// Состояние задания.
// 
// Параметры:
//  КлючЗадания - УникальныйИдентификатор - Ключ задания
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.СостоянияЗаданийМенеджераЗаданий
//  
Функция СостояниеЗадания(КлючЗадания) Экспорт
	
	Результат = РегистрыСведений.ЗаданияМенеджераЗаданий.СостояниеЗадания(КлючЗадания);
	Если Результат = Неопределено Тогда
		Результат = Перечисления.СостоянияЗаданийМенеджераЗаданий.ПустаяСсылка();
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

#КонецОбласти
