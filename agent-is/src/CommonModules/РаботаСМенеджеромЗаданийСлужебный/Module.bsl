//
Функция КомментарийЖурналаРегистрацииКлючЗадания(КлючЗадания)
	Шаблон = "Задание = [КлючЗадания]";
	Параметры = Новый Структура("КлючЗадания", Строка(КлючЗадания));
	Результат = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, Параметры);
	Возврат Результат;
КонецФункции

