// @strict-types

#Область ПрограммныйИнтерфейс

#Область ОбработчикРегламентногоЗадания

// Обработчик рег. зазания "МенеджерЗаданий".
//
Процедура МенеджерЗаданий() Экспорт
	
	АктивныеИсполнители = АктивныеИсполнителиСейчас();
	НастройкиМетодовОбработчиков = НастройкиМетодовОбработчиковМенеджераЗаданий();
	ОсвободитьЗаданияБезАктивныхИсполнителей(АктивныеИсполнители, НастройкиМетодовОбработчиков);
	ОтменитьЗаданияСДостигнутымЛимитомПоМаксимальномуКоличествуПопытокВыполнения();
	СнятьЗаданияСПаузы(НастройкиМетодовОбработчиков);
	ЗапуститьНовыхИсполнителей(АктивныеИсполнители);
	СократитьИсториюВыполненияЗаданийДоГлубиныХраненияИзНастроек();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиИсполнителя

// Исполнитель выполнение.
// 
// Параметры:
//  КлючИдентификацииИсполнителя - Строка -  Ключ идентификации исполнителя
//  КлючЗадания - УникальныйИдентификатор - Ключ задания
//
Процедура ИсполнительВыполнение(КлючИдентификацииИсполнителя, КлючЗадания) Экспорт

	УникальныйИдентификаторИсполнителя = УникальныйИдентификаторИсполнителя(КлючИдентификацииИсполнителя);
	ДеталиЗадания = ВзятьЗаданиеВРаботу(КлючЗадания, УникальныйИдентификаторИсполнителя);
	Если ЗначениеЗаполнено(ДеталиЗадания) Тогда           
		ПараметрыВызова = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДеталиЗадания.Параметры);
		РезультатВыполнения = ОбщегоНазначения.ВызватьФункциюКонфигурации(ДеталиЗадания.ИмяМетода, ПараметрыВызова);
		ОтметитьЗавершениеЗадания(КлючЗадания, РезультатВыполнения);
	КонецЕсли;

КонецПроцедуры

// Спать.
// 
// Параметры:
//  Секунд - Число - Секунд
// 
// Возвращаемое значение:
//  Число
//
Функция Спать(Секунд) Экспорт
	
	ТекущийСеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
    ФоновоеЗадание = ТекущийСеансИнформационнойБазы.ПолучитьФоновоеЗадание();
    
    Если ФоновоеЗадание = Неопределено Тогда
        Параметры = Новый Массив; // Массив Из Число
        Параметры.Добавить(Секунд);
        ФоновоеЗадание = ФоновыеЗадания.Выполнить(ИмяМетодаСпать(), Параметры);
    КонецЕсли;
        
    ФоновоеЗадание.ОжидатьЗавершенияВыполнения(Секунд);
   	 
    Возврат Секунд;
КонецФункции

#КонецОбласти

#Область ПоддержкаФормыАдминистрирования

// Сведения об исполнителях и заданиях.
// 
// Возвращаемое значение:
//  Структура - Сведения об исполнителях и заданиях:
// * АктивныеИсполнители - Число
// * ВОчереди - Число
// * НаПаузе - Число
// * Всего - Число
//
Функция СведенияОбИсполнителяхИЗаданиях() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("АктивныеИсполнители", 0);
	Результат.Вставить("ВОчереди", 0);
	Результат.Вставить("НаПаузе", 0);
	Результат.Вставить("Всего", 0);
	
	Результат.АктивныеИсполнители = АктивныеИсполнителиСейчас().Количество();
	Результат.ВОчереди = РегистрыСведений.ЗаданияМенеджераЗаданий.КоличествоЗаданийВОчереди();
	Результат.НаПаузе = РегистрыСведений.ЗаданияМенеджераЗаданий.КоличествоЗаданийНаПаузе();
	Результат.Всего = Результат.АктивныеИсполнители + Результат.ВОчереди + Результат.НаПаузе;
	
	Возврат Результат;
	
КонецФункции

// Запустить выполнение заданий.
//
Процедура ЗапуститьВыполнениеЗаданий() Экспорт
	ЗапуститьМенеджерЗаданий();
КонецПроцедуры

// Остановить выполнение заданий.
//
Процедура ОстановитьВыполнениеЗаданий() Экспорт
	ОстановитьМенеджерЗаданий();
	ОстановитьАктивныхИсполнителей();
КонецПроцедуры

// Отменить все задания в очереди.
//
Процедура ОтменитьВсеЗаданияВОчереди() Экспорт
	РегистрыСведений.ЗаданияМенеджераЗаданий.ОтменитьВсеЗаданияВОчереди();
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИсполнениеЗаданий

// Уникальный идентификатор исполнителя.
// 
// Параметры:
//  КлючИдентификацииИсполнителя - Строка - Ключ идентификации исполнителя
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Уникальный идентификатор исполнителя
//
Функция УникальныйИдентификаторИсполнителя(КлючИдентификацииИсполнителя)
	
	Отбор = Новый Структура("Ключ", КлючИдентификацииИсполнителя);
	НайденныеФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	Если НайденныеФоновыеЗадания.ВГраница() = -1 Тогда
		ШаблонТекстаИсключения = 
			"Фоновое задание по ключу [КлючИдентификацииИсполнителя] не найдено!";
		ПараметрыТекстаИсключения = Новый Структура("КлючИдентификацииИсполнителя", КлючИдентификацииИсполнителя);
		ТекстИсключения = 
			СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
				ШаблонТекстаИсключения, 
				ПараметрыТекстаИсключения);
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	ФоновоеЗадание = НайденныеФоновыеЗадания[0];
	УникальныйИдентификаторИсполнителя = ФоновоеЗадание.УникальныйИдентификатор;
	Возврат УникальныйИдентификаторИсполнителя;
	
КонецФункции

#КонецОбласти

#Область ЛогикаМенеджераЗаданий

// Запустить менеджер заданий.
//
Процедура ЗапуститьМенеджерЗаданий()
	
	ОстановитьМенеджерЗаданий();
	РегламентноеЗадание = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.МенеджерЗаданий);
	РегламентноеЗадание.Использование = Истина;
	РегламентноеЗадание.Записать();
	
КонецПроцедуры

// Остановить менеджер заданий.
//
Процедура ОстановитьМенеджерЗаданий()
	
	Отбор = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.МенеджерЗаданий);
	НайденныеРегламентныеЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);
	Для каждого РегламентноеЗадание Из НайденныеРегламентныеЗадания Цикл
		РегламентноеЗадание.Удалить();
	КонецЦикла;
	
КонецПроцедуры

// Остановить активных исполнителей.
//
Процедура ОстановитьАктивныхИсполнителей()
	АктивныеИсполнители = АктивныеИсполнителиСейчас();
	Для Каждого АктивныйИсполнитель Из АктивныеИсполнители Цикл
		Если АктивныйИсполнитель.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			 АктивныйИсполнитель.Отменить();
		КонецЕсли;	 
	КонецЦикла;
КонецПроцедуры

// Активные исполнители сейчас.
// 
// Возвращаемое значение:
//  Массив Из ФоновоеЗадание - Активные исполнители сейчас
//
Функция АктивныеИсполнителиСейчас()
	
	Отбор = Новый Структура("ИмяМетода", ИмяМетодаИсполнительВыполнение());
	ВсеФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	АктивныеИсполнители = Новый Массив; // Массив Из ФоновоеЗадание
	Для Каждого Фоновое Из ВсеФоновыеЗадания Цикл
		Если Фоновое.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			АктивныеИсполнители.Добавить(Фоновое);
		КонецЕсли;
	КонецЦикла;
	
	Возврат АктивныеИсполнители;
	
КонецФункции

// Настройки методов обработчиков менеджера заданий.
// 
// Возвращаемое значение:
//  см. РегистрыСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.ПоИменамМетодов
//
Функция НастройкиМетодовОбработчиковМенеджераЗаданий()
	
	Возврат РегистрыСведений.НастройкиМетодовОбработчиковМенеджераЗаданий.ПоИменамМетодов();
	
КонецФункции

// Освободить задания без активных исполнителей.
// 
// Параметры:
//  АктивныеИсполнители см. АктивныеИсполнителиСейчас
//  НастройкиМетодовОбработчиков см. НастройкиМетодовОбработчиков
//
Процедура ОсвободитьЗаданияБезАктивныхИсполнителей(АктивныеИсполнители, НастройкиМетодовОбработчиков)
	
	УИДыАктивныхИсполнителей = КоллекцияУИДПоКоллекцииФоновыхЗаданий(АктивныеИсполнители);
	РегистрыСведений.ЗаданияМенеджераЗаданий.ОсвободитьЗаданияБезАктивныхИсполнителей(
		НастройкиМетодовОбработчиков,
		УИДыАктивныхИсполнителей);
	
КонецПроцедуры

// Отменить задания с достигнутым лимитом по максимальному количеству попыток выполнения.
// 
Процедура ОтменитьЗаданияСДостигнутымЛимитомПоМаксимальномуКоличествуПопытокВыполнения()
	
	РегистрыСведений.ЗаданияМенеджераЗаданий.
		ОтменитьЗаданияСДостигнутымЛимитомПоМаксимальномуКоличествуПопытокВыполнения();
	
КонецПроцедуры

// Снять задания с паузы.
// 
// Параметры:
//  НастройкиМетодовОбработчиков см. НастройкиМетодовОбработчиков
//
Процедура СнятьЗаданияСПаузы(НастройкиМетодовОбработчиков)
	
	РегистрыСведений.ЗаданияМенеджераЗаданий.
		СнятьЗаданияСПаузы(НастройкиМетодовОбработчиков);
	
КонецПроцедуры

// Запустить новых исполнителей.
// 
// Параметры:
//  АктивныеИсполнители см. АктивныеИсполнителиСейчас
//
Процедура ЗапуститьНовыхИсполнителей(АктивныеИсполнители)
	
	КоличествоЗаданийВОчереди = 
		РегистрыСведений.ЗаданияМенеджераЗаданий.КоличествоЗаданийВОчереди();
	ОграничениеНаКоличествоИсполнителей = 
		РегистрыСведений.НастройкиМенеджераЗаданий.ОграничениеНаКоличествоИсполнителей();
	КоличествоДобавляемыхИсполнителей = 
		Мин(
			ОграничениеНаКоличествоИсполнителей - АктивныеИсполнители.Количество(),
			КоличествоЗаданийВОчереди);
	Если КоличествоДобавляемыхИсполнителей > 0 Тогда
		КлючиЗаданий = 
			РегистрыСведений.ЗаданияМенеджераЗаданий.КлючиЗаданийИзОчереди(КоличествоДобавляемыхИсполнителей);
		Для Каждого Ключ Из КлючиЗаданий Цикл
			КлючИдентификацииИсполнителя = СгенерироватьКлючИдентификацииИсполнителя();
			ЗапуститьИсполнителя(КлючИдентификацииИсполнителя, Ключ);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Запустить исполнителя.
// 
// Параметры:
//  КлючИдентификацииИсполнителя - Строка - Ключ идентификации исполнителя
//  КлючЗадания - УникальныйИдентификатор - Ключ задания
//
Процедура ЗапуститьИсполнителя(КлючИдентификацииИсполнителя, КлючЗадания)
	
	ПараметрыФоновогоЗаданияИсполнителя = Новый Массив; // Массив Из Строка, УникальныйИдентификатор
	ПараметрыФоновогоЗаданияИсполнителя.Добавить(КлючИдентификацииИсполнителя);
	ПараметрыФоновогоЗаданияИсполнителя.Добавить(КлючЗадания);
	
	ФоновыеЗадания.Выполнить(
		ИмяМетодаИсполнительВыполнение(),
		ПараметрыФоновогоЗаданияИсполнителя,
		КлючИдентификацииИсполнителя);
	
КонецПроцедуры

// Взять задание в работу.
// 
// Блокируем РС "ЗаданияМенеджераЗаданий" по ключу задания, чтобы одно и то же задание не могло 
// начать выполняться одновременно в разных сеансах
// 
// Параметры:
//  КлючЗадания - УникальныйИдентификатор - Ключ задания
//  УникальныйИдентификаторИсполнителя - УникальныйИдентификатор - Уникальный идентификатор исполнителя
// 
// Возвращаемое значение:
//  Неопределено, Структура - Взять задание в работу:
// * ИмяМетода - Строка
// * Параметры - Произвольный
//
Функция ВзятьЗаданиеВРаботу(КлючЗадания, УникальныйИдентификаторИсполнителя)
	
	Результат = Неопределено;
	
	НачатьТранзакцию();
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных();
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ЗаданияМенеджераЗаданий");
		ЭлементБлокировки.УстановитьЗначение("Ключ", КлючЗадания);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		Результат = 
			РегистрыСведений.ЗаданияМенеджераЗаданий.ВзятьЗаданиеВРаботу(
				КлючЗадания,
				УникальныйИдентификаторИсполнителя);
		
		ОтметитьВЖРНачалоВыполненияЗадания(КлючЗадания);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОтметитьВЖРОшибкуНачалаВыполненияЗадания(КлючЗадания, ОписаниеОшибки);
		Результат = Неопределено;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Отметить завершение задания.
// 
// Параметры:
//  КлючЗадания - УникальныйИдентификатор - Ключ задания
//  РезультатВыполнения - Произвольный - Результат выполнения
//
Процедура ОтметитьЗавершениеЗадания(КлючЗадания, РезультатВыполнения)
	
	РегистрыСведений.ЗаданияМенеджераЗаданий.ОтметитьЗавершениеЗадания(
				КлючЗадания,
				РезультатВыполнения);
	ОтметитьВЖРЗавершениеВыполненияЗадания(КлючЗадания);
	
КонецПроцедуры

// Сократить историю выполнения заданий до глубины хранения из настроек.
//
Процедура СократитьИсториюВыполненияЗаданийДоГлубиныХраненияИзНастроек()
	
	ГлубинаХраненияИстории = 
		РегистрыСведений.НастройкиМенеджераЗаданий.ГлубинаХраненияИстории();
	ПредопределенныеЗначенияГлубиныХраненияИстории = 
		РегистрыСведений.НастройкиМенеджераЗаданий.ПредопределенныеЗначенияГлубиныХраненияИстории();
	Если ГлубинаХраненияИстории <> ПредопределенныеЗначенияГлубиныХраненияИстории.Бесконечная Тогда
		РегистрыСведений.ЗаданияМенеджераЗаданий.СократитьИсторияВыполненияЗаданий(ГлубинаХраненияИстории);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПредопределенныеЛитералы

// Имя метода исполнитель выполнение.
// 
// Возвращаемое значение:
//  Строка - Имя метода исполнитель выполнение
//
Функция ИмяМетодаИсполнительВыполнение()
	Возврат "РаботаСМенеджеромЗаданийСлужебный.ИсполнительВыполнение";
КонецФункции

// Имя метода спать.
// 
// Возвращаемое значение:
//  Строка - Имя метода спать
//
Функция ИмяМетодаСпать()
	Возврат "РаботаСМенеджеромЗаданийСлужебный.Спать";
КонецФункции

// Префикс ключа исполнителей.
// 
// Возвращаемое значение:
//  Строка - Префикс ключа исполнителей
//
Функция ПрефиксКлючаИсполнителей()
	Возврат "мз_";
КонецФункции

#КонецОбласти

#Область Дополнительные

// Коллекция УИД по коллекции фоновых заданий.
// 
// Параметры:
//  КоллекцияФоновыхЗаданий - Массив из ФоновоеЗадание - Коллекция фоновых заданий
// 
// Возвращаемое значение:
//  Массив Из УникальныйИдентификатор - Коллекция УИД по коллекции фоновых заданий
//
Функция КоллекцияУИДПоКоллекцииФоновыхЗаданий(КоллекцияФоновыхЗаданий)
	
	УИДы = Новый Массив; // Массив Из УникальныйИдентификатор
	
	Для каждого Исполнитель Из КоллекцияФоновыхЗаданий Цикл
		УИДы.Добавить(Исполнитель.УникальныйИдентификатор);
	КонецЦикла;
	
	Возврат УИДы;
	
КонецФункции

