// События заданий для ЖР.
// 
// Возвращаемое значение:
//  Структура - События заданий для ЖР:
//  * НачалоВыполненияЗадания - Строка - Начало выполнения задания
//  * ОшибкаНачалаВыполненияЗадания - Строка - Не удалось начать выполнение задания
//  * ЗавершениеВыполненияЗадания - Строка - Завершение выполнения задания
//
Функция СобытияЗаданийДляЖР()
	Результат = Новый Структура;
	Результат.Вставить("НачалоВыполненияЗадания", "Начало выполнения задания");
	Результат.Вставить("ОшибкаНачалаВыполненияЗадания", "Не удалось начать выполнение задания");
	Результат.Вставить("ЗавершениеВыполненияЗадания", "Завершение выполнения задания");
	Возврат Результат;
КонецФункции

// Комментарий журнала регистрации ключ задания.
