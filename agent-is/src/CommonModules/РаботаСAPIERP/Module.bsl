// @strict-types

#Область ПрограммныйИнтерфейс

// Отправить результат пакета заданий COMСоединений.
// 
// Параметры:
//  ОбработчикЗадания - ПеречислениеСсылка.ОбработчикиЗаданийCOMСоединений - Обработчик задания
//  РезультатВыполненияПакетаЗаданий - Структура, Массив Из Структура - Результат выполнения пакета заданий
// 
// Возвращаемое значение:
//  см. РезультатОтправки
//
Функция ОтправитьРезультатПакетаЗаданийCOMСоединений(ОбработчикЗадания, РезультатВыполненияПакетаЗаданий) Экспорт
	
	Результат = РезультатОтправки();
	
	СтрокаJSON = РаботаСJSON.СериализоватьJSON(РезультатВыполненияПакетаЗаданий);
	
	ЗначенияНастроек = РегистрыСведений.НастройкиИнтеграцииСERP.ЗначенияНастроек();
	АдресСервисаСинхронизацииЕРП = ЗначенияНастроек.АдресСервисаСинхронизацииЕРП;
	Если Не ЗначениеЗаполнено(АдресСервисаСинхронизацииЕРП) Тогда
		ВызватьИсключение "Не задано значение настройки <АдресСервисаСинхронизацииЕРП>. Проверьте настройки!";
	КонецЕсли;
	
	СтруктураURIСервисаСинхронизации = ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресСервисаСинхронизацииЕРП);
	
	СоединениеHTTP = 
		РаботаСHTTP.ПодготовитьСоединениеHTTP(
			СтруктураURIСервисаСинхронизации.Хост,
			СтруктураURIСервисаСинхронизации.Порт,
			60);
	ЗаголовкиHTTPЗапроса = 
		РаботаСHTTP.СтандартныеЗаголовкиЗапросаHTTP();
	ЗапросHTTP = 
		РаботаСHTTP.ПодготовитьЗапросHTTP(
			СтруктураURIСервисаСинхронизации.ПутьНаСервере,
			ЗаголовкиHTTPЗапроса, 
			СтрокаJSON);
			
	РезультатЗапросаHTTP = 
		РаботаСHTTP.ВыполнитьЗапросHTTP(
			"POST",
			СоединениеHTTP,
			ЗапросHTTP,
			Ложь,
			Ложь,
			Ложь);
	
	Результат.Успех = РезультатЗапросаHTTP.Выполнен И РезультатЗапросаHTTP.КодСостояния = 200;
	Результат.Данные = РезультатЗапросаHTTP.ДесериализованныйJSONОтвета;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Результат отправки результата пакета.
// 
// Возвращаемое значение:
//  Структура - Результат отправки результата пакета:
// * Успех - Булево
// * Данные - Неопределено, Структура - данные ответа или Неопределено 
// * ОписаниеОшибки - Строка
//
Функция РезультатОтправки()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Данные", Неопределено);
	Результат.Вставить("ОписаниеОшибки", "");
	Возврат Результат;
	
КонецФункции

#КонецОбласти
